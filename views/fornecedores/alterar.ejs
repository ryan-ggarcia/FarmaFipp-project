<script src="/js/fornecedores/alterar.js"></script>

<div class="p-3 p-1-25">

  <!-- ── Dados do Fornecedor ── -->
  <div class="card card-saas no-hover mb-3">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-pencil-square me-2"></i>Alterar Dados do Fornecedor
      </h4>

      <!-- ID oculto -->
      <input type="hidden" id="id" value="<%= fornecedor.id %>">

      <div class="row g-3">

        <div class="col-md-4">
          <label class="form-label">Nome</label>
          <input type="text" id="nome" class="form-control"
                 value="<%= fornecedor.nome %>" placeholder="Nome do fornecedor">
        </div>

        <div class="col-md-4">
          <label class="form-label">CNPJ</label>
          <input type="text" id="cnpj" class="form-control" maxlength="18"
                 value="<%= fornecedor.cnpj %>" placeholder="00.000.000/0000-00"
                 autocomplete="off">
        </div>

        <div class="col-md-4">
          <label class="form-label">Telefone</label>
          <input type="text" id="telefone" class="form-control" maxlength="15"
                 value="<%= fornecedor.telefone %>" placeholder="(00) 00000-0000"
                 autocomplete="off">
        </div>

        <div class="col-md-4">
          <label class="form-label">Status</label>
          <select id="status" class="form-control">
            <option value="ativo"   <%= fornecedor.status === 'ativo'   ? 'selected' : '' %>>Ativo</option>
            <option value="inativo" <%= fornecedor.status === 'inativo' ? 'selected' : '' %>>Inativo</option>
          </select>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Endereço ── -->
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-geo-alt me-2"></i>Alterar Endereço
      </h4>
      <div class="row g-3">

        <div class="col-md-4">
          <label class="form-label">CEP</label>
          <input type="text" id="cep" class="form-control" maxlength="9"
                 value="<%= endereco.endCep %>" placeholder="00000-000">
        </div>

        <div class="col-md-4">
          <label class="form-label">Rua</label>
          <input type="text" id="rua" class="form-control"
                 value="<%= endereco.endRua %>" placeholder="Nome da rua">
        </div>

        <div class="col-md-4">
          <label class="form-label">Número</label>
          <input type="text" id="num" class="form-control"
                 value="<%= endereco.endNum %>" placeholder="Nº">
        </div>

        <div class="col-md-4">
          <label class="form-label">Bairro</label>
          <input type="text" id="bairro" class="form-control"
                 value="<%= endereco.endBairro %>" placeholder="Bairro">
        </div>

        <div class="col-md-4">
          <label class="form-label">Cidade</label>
          <input type="text" id="cidade" class="form-control"
                 value="<%= endereco.endCidade %>" placeholder="Cidade">
        </div>

        <div class="col-md-4">
          <label class="form-label">Estado</label>
          <input type="text" id="estado" class="form-control"
                 value="<%= endereco.endEstado %>" placeholder="Estado">
        </div>

        <div class="col-md-4">
          <label class="form-label">UF</label>
          <input type="text" id="uf" class="form-control" maxlength="2"
                 value="<%= endereco.endUf %>" placeholder="SP">
        </div>

        <div class="col-12 d-flex gap-2 mt-1">
          <button id="alterar" type="button"
                  class="btn btn-primary custom btn-rounded">
            <i class="fas fa-save me-1"></i>Salvar Alterações
          </button>
          <a href="/admin/fornecedores" class="btn btn-outline-secondary btn-rounded">
            <i class="fas fa-arrow-left me-1"></i>Voltar
          </a>
        </div>

      </div>
    </div>
  </div>

</div>
