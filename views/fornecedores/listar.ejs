<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h1>Listar Fornecedores</h1>

    <button><a href="/fornecedores/cadastrar">Cadastrar Novo Fornecedor</a></button>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>CNPJ</th>
                <th>Telefone</th>
                <th>Endereço</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            
                <% fornecedores.forEach(fornecedor => { %>
                    <tr>
                        <td><%= fornecedor.id %></td>
                        <td><%= fornecedor.nome %></td>
                        <td><%= fornecedor.cnpj %></td>
                        <td><%= fornecedor.telefone %></td>
                        </td>
                        <td>
                            <a href="/fornecedores/alterar/<%= fornecedor.id %>" class="btn btn-primary btn-sm">Alterar</a>
                            <button data-id="<%= fornecedor.id %>"   class="btn btn-danger btn-sm btnExcluir">Excluir</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
    </table>
</body>
</html>

<script src="/js/fornecedores/listar.js"></script>