<script src="/js/produtos/alterar.js"></script>

<%
  /* ── normalização de variáveis (mantido intacto) ── */
  const produtoAtual = typeof produto !== 'undefined' && produto
    ? produto
    : (typeof produtoAlter !== 'undefined' ? produtoAlter : {});

  const listaCategoriasView = typeof categorias !== 'undefined' && categorias
    ? categorias
    : (typeof listaCategorias !== 'undefined' ? listaCategorias : []);

  const listaFornecedoresView = typeof fornecedores !== 'undefined' && fornecedores
    ? fornecedores
    : (typeof listaFornecedores !== 'undefined' ? listaFornecedores : []);

  const produtoId        = produtoAtual.id          || produtoAtual.produtoId       || '';
  const produtoNome      = produtoAtual.nome         || produtoAtual.produtoNome     || '';
  const produtoDescricao = produtoAtual.descricao    || produtoAtual.produtoDescricao|| '';
  const produtoPreco     = produtoAtual.preco        || produtoAtual.produtoValor    || '';
  const produtoQuantidade= produtoAtual.quantidade   || produtoAtual.produtoQuantidade|| 0;
  const produtoMarca     = produtoAtual.marca        || produtoAtual.marcaNome       || '';
  const produtoCategoria = produtoAtual.categoria    || produtoAtual.categoriaId     || '';
  const produtoFornecedor= produtoAtual.fornecedor   || produtoAtual.fornecedorId    || '';
  const produtoImagem    = produtoAtual.img          || produtoAtual.produtoImagem   || '/img/produtos/barra-de-imagem.png';
%>

<div class="p-3 p-1-25">
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-pencil-square me-2"></i>Alterar Produto
      </h4>

      <form id="formAlterar">
        <!-- ID oculto -->
        <input type="hidden" id="id" value="<%= produtoId %>">

        <div class="row g-3">

          <!-- Nome -->
          <div class="col-md-4">
            <label class="form-label">Nome do Produto</label>
            <input type="text" class="form-control" id="nome"
                   value="<%= produtoNome %>" placeholder="Nome do produto">
          </div>

          <!-- Marca -->
          <div class="col-md-4">
            <label class="form-label">Marca</label>
            <input type="text" class="form-control" id="marca"
                   value="<%= produtoMarca %>" placeholder="Marca">
          </div>

          <!-- Preço -->
          <div class="col-md-4">
            <label class="form-label">Preço (R$)</label>
            <input type="number" class="form-control" id="preco"
                   value="<%= produtoPreco %>" step="0.01" min="0.01" placeholder="0,00">
          </div>

          <!-- Quantidade -->
          <div class="col-md-4">
            <label class="form-label">Quantidade</label>
            <input type="number" class="form-control" id="quantidade"
                   value="<%= produtoQuantidade %>" min="0" placeholder="0">
          </div>

          <!-- Categoria -->
          <div class="col-md-4">
            <label class="form-label">Categoria</label>
            <select class="form-control" id="categoria">
              <option value="">Selecione uma categoria</option>
              <% for(let i = 0; i < listaCategoriasView.length; i++){ %>
                <% const catId   = listaCategoriasView[i].idCategoria  || listaCategoriasView[i].categoriaId; %>
                <% const catNome = listaCategoriasView[i].cat_nome     || listaCategoriasView[i].categoriaNome; %>
                <option value="<%= catId %>"
                  <%= String(catId) === String(produtoCategoria) ? 'selected' : '' %>>
                  <%= catNome %>
                </option>
              <% } %>
            </select>
          </div>

          <!-- Fornecedor -->
          <div class="col-md-4">
            <label class="form-label">Fornecedor</label>
            <select class="form-control" id="fornecedor">
              <option value="">Selecione um fornecedor</option>
              <% listaFornecedoresView.filter(f => f.status === 'ativo').forEach(function(forn){ %>
                <% const fornId   = forn.id   || forn.idFornecedor  || forn.fornecedorId; %>
                <% const fornNome = forn.nome  || forn.forn_nome     || forn.fornecedorNome; %>
                <option value="<%= fornId %>"
                  <%= String(fornId) === String(produtoFornecedor) ? 'selected' : '' %>>
                  <%= fornNome %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Imagem -->
          <div class="col-md-4">
            <label class="form-label">Imagem do Produto</label>
            <input type="file" class="form-control" id="img"
                   accept="image/jpeg,image/png,image/webp">
          </div>

          <!-- Descrição -->
          <div class="col-12">
            <label class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" rows="3"
                      placeholder="Descrição do produto..."><%= produtoDescricao %></textarea>
          </div>

          <!-- Prévia da imagem atual -->
          <div class="col-md-4" id="divPrevia">
            <label class="form-label">Imagem Atual</label>
            <img src="<%= produtoImagem %>" id="previaImg"
                 style="max-width:100%; border-radius:8px; border:1px solid #eee; margin-top:.25rem;">
          </div>

          <!-- Botões -->
          <div class="col-12 d-flex gap-2 mt-1">
            <button type="button" id="btnAlterar"
                    class="btn btn-primary custom btn-rounded">
              <i class="fas fa-save me-1"></i>Salvar Alterações
            </button>
            <a href="/admin/produtos" class="btn btn-outline-secondary btn-rounded">
              <i class="fas fa-arrow-left me-1"></i>Voltar
            </a>
          </div>

        </div>
      </form>
    </div>
  </div>
</div>
