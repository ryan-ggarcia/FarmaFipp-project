<script src="/js/produtos/cadastrar.js"></script>

<div class="p-3 p-1-25">
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-plus-circle me-2"></i>Cadastrar Produto
      </h4>

      <form id="formCadastrar">
        <div class="row g-3">

          <!-- Nome -->
          <div class="col-md-4">
            <label class="form-label">Nome do Produto</label>
            <input type="text" class="form-control" id="nome" name="nome"
                   required placeholder="Ex: Dipirona 500mg">
          </div>

          <!-- Marca -->
          <div class="col-md-4">
            <label class="form-label">Marca</label>
            <input type="text" class="form-control" id="marca" name="marca"
                   required placeholder="Ex: EMS">
          </div>

          <!-- Validade -->
          <div class="col-md-4">
            <label class="form-label">Validade</label>
            <input type="date" class="form-control" id="validade" name="validade" required>
          </div>

          <!-- Preço -->
          <div class="col-md-4">
            <label class="form-label">Preço (R$)</label>
            <input type="number" class="form-control" id="preco" name="preco"
                   step="0.01" min="0.01" required placeholder="0,00">
          </div>

          <!-- Quantidade -->
          <div class="col-md-4">
            <label class="form-label">Quantidade</label>
            <input type="number" class="form-control" id="quantidade" name="quantidade"
                   min="0" required placeholder="0">
          </div>

          <!-- Categoria -->
          <div class="col-md-4">
            <label class="form-label">Categoria</label>
            <select class="form-control" id="categoria" name="categoria" required>
              <option value="">Selecione uma categoria</option>
              <% categorias.forEach(function(c){ %>
                <option value="<%= c.idCategoria %>"><%= c.cat_nome %></option>
              <% }); %>
            </select>
          </div>

          <!-- Fornecedor -->
          <div class="col-md-4">
            <label class="form-label">Fornecedor</label>
            <select class="form-control" id="fornecedor" name="fornecedor" required>
              <option value="">Selecione um fornecedor</option>
              <% fornecedores.filter(f => f.status === 'ativo').forEach(function(f){ %>
                <option value="<%= f.id %>"><%= f.nome %></option>
              <% }); %>
            </select>
          </div>

          <!-- Imagem -->
          <div class="col-md-4">
            <label class="form-label">Imagem do Produto</label>
            <input type="file" class="form-control" id="img" name="img"
                   accept="image/jpeg,image/png,image/webp">
          </div>

          <!-- Descrição -->
          <div class="col-12">
            <label class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" name="descricao"
                      rows="3" placeholder="Descreva o produto..."></textarea>
          </div>

          <!-- Prévia da imagem (hidden até selecionar arquivo) -->
          <div class="col-md-4" id="divPrevia" style="display:none;">
            <label class="form-label">Prévia da Imagem</label>
            <img id="previaImagem" src="#"
                 style="max-width:100%; border-radius:8px; border:1px solid #eee; margin-top:.25rem;">
          </div>

          <!-- Botões -->
          <div class="col-12 d-flex gap-2 mt-1">
            <button type="button" id="cadastrar"
                    class="btn btn-primary custom btn-rounded">
              <i class="fas fa-save me-1"></i>Cadastrar Produto
            </button>
            <a href="/admin/produtos" class="btn btn-outline-secondary btn-rounded">
              <i class="fas fa-arrow-left me-1"></i>Voltar
            </a>
          </div>

        </div>
      </form>
    </div>
  </div>
</div>
