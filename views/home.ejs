<%
/* ── Totais para os KPI cards ── */
const _totalProdutos    = (produtos    && produtos.length)    ? produtos.length    : 0;
const _totalServicos    = (servicos    && servicos.length)    ? servicos.length    : 0;
const _totalClientes    = (clientes    && clientes.length)    ? clientes.length    : 0;
const _totalFuncionarios= (funcionarios&& funcionarios.length)? funcionarios.length: 0;
const _totalFornecedores= (fornecedores && fornecedores.length) ? fornecedores.filter(f => f.status === 'ativo').length : 0;

/* ── Formata moeda BRL ── */
function _brl(v){ return 'R$ ' + (v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
%>

<!-- ══════════════════════════════════════════════════════════
     CABEÇALHO DO DASHBOARD
══════════════════════════════════════════════════════════════ -->
<section class="dash-header-section mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1 class="h3 mb-0">Dashboard</h1>
      <p class="text-muted mb-0 small">Visão geral do sistema</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="text-muted small">Período:</span>
      <div class="btn-group btn-group-sm" id="periodFilter" role="group" aria-label="Filtro de período">
        <button type="button" class="btn btn-outline-secondary period-btn" data-period="dia">Dia</button>
        <button type="button" class="btn btn-outline-secondary period-btn active" data-period="mes">Mês</button>
        <button type="button" class="btn btn-outline-secondary period-btn" data-period="ano">Ano</button>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     KPI CARDS
══════════════════════════════════════════════════════════════ -->
<div class="dash-kpi-row mb-4">

  <!-- Produtos -->
  <div class="kpi-card">
    <div class="kpi-top">
      <div class="kpi-icon-wrap kpi-icon-blue"><i class="bi bi-box-seam"></i></div>
    </div>
    <div class="kpi-value"><%= _totalProdutos %></div>
    <div class="kpi-label">Produtos</div>
  </div>

  <!-- Serviços -->
  <div class="kpi-card">
    <div class="kpi-top">
      <div class="kpi-icon-wrap kpi-icon-red"><i class="bi bi-tools"></i></div>
    </div>
    <div class="kpi-value"><%= _totalServicos %></div>
    <div class="kpi-label">Serviços</div>
  </div>

  <!-- Clientes -->
  <div class="kpi-card">
    <div class="kpi-top">
      <div class="kpi-icon-wrap kpi-icon-green"><i class="bi bi-people"></i></div>
    </div>
    <div class="kpi-value"><%= _totalClientes %></div>
    <div class="kpi-label">Clientes</div>
  </div>

  <!-- Funcionários -->
  <div class="kpi-card">
    <div class="kpi-top">
      <div class="kpi-icon-wrap kpi-icon-yellow"><i class="bi bi-person-badge"></i></div>
    </div>
    <div class="kpi-value"><%= _totalFuncionarios %></div>
    <div class="kpi-label">Funcionários</div>
  </div>

  <!-- Fornecedores -->
  <div class="kpi-card">
    <div class="kpi-top">
      <div class="kpi-icon-wrap kpi-icon-teal"><i class="bi bi-truck"></i></div>
    </div>
    <div class="kpi-value"><%= _totalFornecedores %></div>
    <div class="kpi-label">Fornecedores</div>
  </div>

</div>

<!-- ══════════════════════════════════════════════════════════
     GRÁFICOS — LINHA 1
══════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-3">

  <!-- ── Vendas (barra) ── -->
  <div class="col-xl-8 col-lg-7">
    <div class="card card-saas no-hover dash-chart-card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
          <div>
            <div class="dash-chart-title">Visão Geral de Vendas</div>
            <div class="dash-chart-subtitle text-muted">Total de vendas por período</div>
          </div>
          <div class="text-end">
            <div class="dash-chart-total" id="totalVendasLabel"><%= _brl(totalVendas) %></div>
            <small class="text-muted"><%= vendasData.length %> transações</small>
          </div>
        </div>
        <canvas id="chartVendas" style="max-height:240px"></canvas>
      </div>
    </div>
  </div>

  <!-- ── Status dos Serviços (donut) ── -->
  <div class="col-xl-4 col-lg-5">
    <div class="card card-saas no-hover dash-chart-card">
      <div class="card-body">
        <div class="dash-chart-title mb-1">Serviços por Status</div>
        <div class="dash-chart-subtitle text-muted mb-3">Distribuição atual</div>
        <canvas id="chartStatus" style="max-height:210px"></canvas>
      </div>
    </div>
  </div>

</div>

<!-- ══════════════════════════════════════════════════════════
     GRÁFICOS — LINHA 2
══════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">

  <!-- ── Serviços (linha) ── -->
  <div class="col-lg-6">
    <div class="card card-saas no-hover dash-chart-card">
      <div class="card-body">
        <div class="dash-chart-title mb-1">Serviços Realizados</div>
        <div class="dash-chart-subtitle text-muted mb-3">Receita de serviços por período</div>
        <canvas id="chartServicos" style="max-height:210px"></canvas>
      </div>
    </div>
  </div>

  <!-- ── Resumo Geral ── -->
  <div class="col-lg-6">
    <div class="card card-saas no-hover h-100">
      <div class="card-body">
        <div class="dash-chart-title mb-3">Resumo Geral</div>
        <table class="dash-summary-table">
          <tbody>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-blue)"></span>Total de Vendas</td>
              <td><strong id="resumoVendas"><%= _brl(totalVendas) %></strong></td>
            </tr>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-red)"></span>Receita de Serviços</td>
              <td><strong><%= _brl(totalServicos) %></strong></td>
            </tr>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-green)"></span>Serviços Aprovados</td>
              <td id="resumoAprovados"><strong>--</strong></td>
            </tr>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-yellow)"></span>Serviços Pendentes</td>
              <td id="resumoPendentes"><strong>--</strong></td>
            </tr>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-red)"></span>Não Aprovados</td>
              <td id="resumoNaoAprovados"><strong>--</strong></td>
            </tr>
            <tr>
              <td><span class="dash-summary-dot" style="background:var(--clr-blue)"></span>Clientes Ativos</td>
              <td><strong><%= _totalClientes %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

