<!-- /.dashboard-grid -->

<!-- ══════════════════════════════════════════════════════════
     SCRIPTS DOS GRÁFICOS
══════════════════════════════════════════════════════════════ -->
<script>
(function () {
  /* ── dados injetados pelo servidor ── */
  const _vendasData   = <%- JSON.stringify(vendasData)   %>;
  const _servicosData = <%- JSON.stringify(servicosData) %>;

  let _period = 'mes';

  /* ── instâncias dos gráficos ── */
  let _chartVendas, _chartServicos, _chartStatus;

  /* ── agrupa dados por período ── */
  function groupBy(data, period, dateKey, valueKey) {
    const groups  = {};
    const ordered = [];
    const now     = new Date();

    // Gera rótulos de período
    function getLabel(d) {
      if (period === 'dia') {
        const diff = Math.floor((now - d) / 86400000);
        if (diff > 29) return null;
        return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
      }
      if (period === 'mes') {
        return d.toLocaleDateString('pt-BR', { month: 'short', year: '2-digit' });
      }
      return String(d.getFullYear());
    }

    data.forEach(item => {
      if (!item[dateKey]) return;
      const d   = new Date(item[dateKey] + 'T00:00:00');
      const key = getLabel(d);
      if (!key) return;
      if (!groups[key]) { groups[key] = 0; ordered.push(key); }
      groups[key] += (item[valueKey] || 0);
    });

    // Remove duplicatas mantendo ordem
    const seen = new Set();
    const labels = ordered.filter(k => { if (seen.has(k)) return false; seen.add(k); return true; });
    const values = labels.map(k => Math.round(groups[k] * 100) / 100);
    return { labels, values };
  }

  /* ── função principal de atualização ── */
  function updateCharts() {
    const vd = groupBy(_vendasData,   _period, 'data', 'valorFinal');
    const sd = groupBy(_servicosData, _period, 'data', 'preco');

    /* total label */
    const total = _vendasData.reduce((a, v) => a + v.valorFinal, 0);
    const fmt   = v => 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
    document.getElementById('totalVendasLabel').textContent = fmt(total);

    /* ── Chart Vendas (barra) ── */
    if (_chartVendas) _chartVendas.destroy();
    _chartVendas = new Chart(document.getElementById('chartVendas'), {
      type: 'bar',
      data: {
        labels: vd.labels.length ? vd.labels : ['Sem dados'],
        datasets: [{
          label: 'Vendas (R$)',
          data:  vd.values.length ? vd.values : [0],
          backgroundColor: 'rgba(78,128,152,.75)',
          borderColor:     'rgba(78,128,152,1)',
          borderWidth: 1,
          borderRadius: 6,
          borderSkipped: false
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => fmt(ctx.raw) } }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f4f4f4' }, ticks: { callback: v => 'R$ ' + v } },
          x: { grid: { display: false } }
        }
      }
    });

    /* ── Chart Serviços (linha) ── */
    if (_chartServicos) _chartServicos.destroy();
    _chartServicos = new Chart(document.getElementById('chartServicos'), {
      type: 'line',
      data: {
        labels: sd.labels.length ? sd.labels : ['Sem dados'],
        datasets: [{
          label: 'Serviços (R$)',
          data:  sd.values.length ? sd.values : [0],
          backgroundColor: 'rgba(163,22,33,.1)',
          borderColor:     'rgba(163,22,33,.85)',
          borderWidth: 2,
          fill: true,
          tension: 0.45,
          pointBackgroundColor: '#A31621',
          pointRadius: 4,
          pointHoverRadius: 6
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => fmt(ctx.raw) } }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f4f4f4' }, ticks: { callback: v => 'R$ ' + v } },
          x: { grid: { display: false } }
        }
      }
    });
  }

  /* ── Chart Status (donut) — estático ── */
  function initStatusChart() {
    const approved = _servicosData.filter(s => s.status === 'aprovado').length;
    const pending  = _servicosData.filter(s => s.status === 'aguardando').length;
    const rejected = _servicosData.filter(s => s.status === 'nao_aprovado').length;
    const none     = _servicosData.filter(s => !s.status || s.status === '0').length;

    /* atualiza resumo lateral */
    const el = id => document.getElementById(id);
    if (el('resumoAprovados'))   el('resumoAprovados').innerHTML   = '<strong>' + approved + '</strong>';
    if (el('resumoPendentes'))   el('resumoPendentes').innerHTML   = '<strong>' + pending  + '</strong>';
    if (el('resumoNaoAprovados'))el('resumoNaoAprovados').innerHTML = '<strong>' + rejected + '</strong>';

    if (_chartStatus) _chartStatus.destroy();
    _chartStatus = new Chart(document.getElementById('chartStatus'), {
      type: 'doughnut',
      data: {
        labels: ['Aprovado', 'Aguardando', 'Não Aprovado', 'Sem status'],
        datasets: [{
          data: [approved, pending, rejected, none],
          backgroundColor: [
            'rgba(45,106,79,.85)',
            'rgba(244,211,94,.9)',
            'rgba(163,22,33,.85)',
            'rgba(173,181,189,.7)'
          ],
          borderWidth: 0,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        cutout: '65%',
        plugins: {
          legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 12 } }
        }
      }
    });
  }

  /* ── filtros de período ── */
  document.querySelectorAll('.period-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      _period = this.dataset.period;
      updateCharts();
    });
  });

  /* ── inicialização ── */
  updateCharts();
  initStatusChart();
})();
</script>
