<script src="/js/servicos/alterar.js"></script>
<div class="p-3 p-1-25">
  <div class="card card-saas">
    <div class="card-body">
      <h4 class="card-title mb-3">Alterar Serviço</h4>
      <form id="formAlterar">
        <input type="hidden" id="id" value="<%= servico.getID() %>">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Data</label>
            <input value="<%= servico.getDATA().toISOString().split('T')[0] %>" id="data" type="date" class="form-control">
          </div>
          <div class="col-md-8">
            <label class="form-label">Tipo</label>
            <input value="<%= servico.getTIPO() %>" id="tipo" type="text" class="form-control">
          </div>
          <div class="col-12">
            <div class="form-check">
              <input <%= servico.getSTATUS() == 'aprovado' ? 'checked' : '' %> id="status" class="form-check-input" type="checkbox">
              <label class="form-check-label" for="status">Aprovado</label>
            </div>
          </div>

        
          <div class="col-12 d-flex gap-2">
            <button id="btnAlterar" type="button" class="btn btn-primary custom btn-rounded">Salvar Alterações</button>
            <a href="/servicos" class="btn btn-outline-secondary btn-rounded">Voltar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>