<script src="/js/servicos/alterar.js"></script>
<div class="p-3 p-1-25">
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">Alterar de Serviços</h4>
      <form id="formAlterar">
        <input id="id" type="hidden" value="<%= servico.getID() %>">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Data</label>
            <% const _dataServico = servico.getDATA() ? new Date(servico.getDATA()) : null; %>
            <input id="data" type="date" class="form-control" value="<%= _dataServico && !Number.isNaN(_dataServico.getTime()) ? _dataServico.toISOString().split('T')[0] : '' %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Hora</label>
            <input id="hora" type="time" class="form-control" value="<%= servico.getHORA()%>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Preço</label>
            <input id="preco" type="text" class="form-control" value="<%=servico.getPRECO()%>">
          </div>
         <div class="col-md-4">
            <div class="form-group">
              <label for="tipo">Tipo</label>
              <select name="tipo" id="tipo" class="form-control">
                <option value="0">--Nenhum--</option>
               <% for(let i = 0; i < listaTipos.length; i++) { %>
                   <option value="<%= listaTipos[i].getID() %>" <%= String(listaTipos[i].getID()) === String(servico.getTIPO()) ? 'selected' : '' %>><%= listaTipos[i].getNOME() %></option>
               <% } %>
              </select>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Funcionário</label>
            <select id="func" class="form-control">
              <option value="0">--Nenhum--</option>
                <%for(let i = 0; i < listaFunc.length; i++ ){%>
                  <option value="<%=listaFunc[i].funcId%>" <%= String(listaFunc[i].funcId) === String(servico.getFUNC()) ? 'selected' : '' %>><%= listaFunc[i].funcNome%></option>
                <%}%>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Cliente</label>
             <select name="clie" id="clie" class="form-control">
              <option value="0">--Nenhum--</option>
              <%if(listaCliente.length > 0){%>
                <%for(let i = 0; i < listaCliente.length; i++ ){%>
                  <option value="<%=listaCliente[i].cliId%>" <%= String(listaCliente[i].cliId) === String(servico.getCLIE()) ? 'selected' : '' %>><%= listaCliente[i].cliNome%></option>
                <%}%>
              <%}%> 
                </select>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="status">Status</label>
              <%
                /* Normaliza o status do banco (Ativo/Aguardando/Inativo) para a opção correspondente */
                const _st = (function(r){
                  r = String(r || '').trim().toLowerCase();
                  if (r === 'ativo' || r === 'aprovado')        return 'aprovado';
                  if (r === 'aguardando')                       return 'aguardando';
                  if (r === 'inativo' || r === 'nao_aprovado')  return 'nao_aprovado';
                  return '';
                })(servico.getSTATUS());
              %>
              <select name="status" id="status" class="form-control">
                <option value="0">--Nenhum--</option>
                <option value="aprovado" <%= _st === 'aprovado' ? 'selected' : '' %>>Aprovado</option>
                <option value="nao_aprovado" <%= _st === 'nao_aprovado' ? 'selected' : '' %>>Não Aprovado</option>
                <option value="aguardando" <%= _st === 'aguardando' ? 'selected' : '' %>>Aguardando Aprovação</option>
              </select>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label">Observações</label>
            <textarea id="obs" class="form-control" rows="3"><%= servico.getOBS() || '' %></textarea>
          </div>

          <div class="col-12 d-flex gap-2 mt-2">
            <button id="btnAlterar" type="button" class="btn btn-primary custom btn-rounded">Salvar Alterações</button>
            <a href="/admin/servicos" class="btn btn-outline-secondary btn-rounded">Voltar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>