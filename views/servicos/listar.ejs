<script src="/js/usuario/listar.js"></script>
<div>
    <h1>Serviços cadastrados</h1>
    <div>
        <a class="btn btn-primary" href="/servicos/cadastrar"><i class="fas fa-plus"></i>Cadastrar Serviço</a>
    </div>
    <br>
    <div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Data</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Descrição</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i = 0; i < lista.length; i++) { %>
                    <tr>
                        <td><%= lista[i].getID() %></td>
                        <td><%= lista[i].getDATA() %></td>
                        <td><%= lista[i].getTIPO() %></td>
                        <td><%= lista[i].getSTATUS() %></td>
                        <td><%= lista[i].getDESC() %></td>
                        <td>
                            <a href="/servicos/alterar/<%= lista[i].getID() %>" class="btn btn-primary">
                                <i class="fas fa-pen"></i>
                            </a>
                            <button data-id="<%= lista[i].getID() %>" class="btn btn-danger btnExcluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                <% } %>
                
            </tbody>


        </table>
    </div>
</div>