<script src="/js/servicos/cadastrar.js"></script>
<div class="p-3 p-1-25">
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">Cadastro de Serviços</h4>
      <form id="formCadastrar">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Data</label>
            <input id="data" type="date" class="form-control">
          </div>
          <div class="col-md-4">
            <label class="form-label">Hora</label>
            <input id="hora" type="time" class="form-control">
          </div>
          <div class="col-md-4">
            <label class="form-label">Preço</label>
            <input id="preco" type="text" class="form-control">
          </div>
         <div class="col-md-4">
            <div class="form-group">
              <label for="tipo">Tipo</label>
              <select name="tipo" id="tipo" class="form-control">
                <option value="0">--Nenhum--</option>
               <% for(let i = 0; i < listaTipos.length; i++) {
                    var _v = listaTipos[i].getVALOR();
                    var _vTxt = (_v != null) ? (' — R$ ' + Number(_v).toFixed(2).replace('.', ',')) : '';
               %>
             <option value="<%= listaTipos[i].getID() %>" data-valor="<%= _v != null ? Number(_v).toFixed(2) : '' %>"><%= listaTipos[i].getNOME() %><%= _vTxt %></option>
               <% } %>
              </select>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Funcionário</label>
            <select id="func" class="form-control">
              <option value="">--Selecione--</option>
              <% for(let i = 0; i < listaFunc.length; i++) { %>
                <option value="<%= listaFunc[i].funcId %>"><%= listaFunc[i].funcNome %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Cliente</label>
            <select id="clie" class="form-control">
              <option value="">--Selecione--</option>
              <% for(let i = 0; i < listaCliente.length; i++) { %>
                <option value="<%= listaCliente[i].cliId %>"><%= listaCliente[i].cliNome %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="status">Status</label>
              <select name="status" id="status" class="form-control">
                <option value="0">--Nenhum--</option>
                <option value="aprovado">Aprovado</option>
                <option value="nao_aprovado">Não Aprovado</option>
                <option value="aguardando">Aguardando Aprovação</option>
              </select>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label">Observações</label>
            <textarea id="obs" class="form-control" rows="3"></textarea>
          </div>
          <div class="col-12 d-flex gap-2">
            <button id="btnGravar" type="button"
              class="btn btn-primary custom btn-rounded">Cadastrar</button>
            <a href="/admin/servicos" class="btn btn-outline-secondary btn-rounded">Voltar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>