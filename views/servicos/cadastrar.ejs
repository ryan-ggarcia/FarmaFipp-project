<script src="/js/servicos/cadastrar.js"></script>
<div class="p-3 p-1-25">
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3" style="color:  rgba(163,22,33,0.95); font-weight: bold;">Cadastro de Serviços</h4>
      <form id="formCadastrar">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Data</label>
            <input id="data" type="date" class="form-control">
          </div>
          <div class="col-md-8">
            <label class="form-label">Tipo</label>
            <input id="tipo" type="text" class="form-control">
          </div>
          <div class="col-12">
            <div class="form-check">
              <input id="status" class="form-check-input" type="checkbox">
              <label class="form-check-label" for="status">Aprovado</label>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label">Descrição</label>
            <textarea id="desc" class="form-control" rows="3"></textarea>
          </div>

          <div class="col-12 d-flex gap-2">
            <button id="btnGravar" type="button" style="margin-right: 5px; margin-top: 5px;" class="btn btn-primary custom btn-rounded">Cadastrar</button>
            <a href="/servicos" style="margin-top: 5px;" class="btn btn-outline-secondary btn-rounded">Voltar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>