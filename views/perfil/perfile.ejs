<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#A31621">
    <title>FarmaFipp — Meu Perfil</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Design Tokens — DEVE VIR ANTES DO CSS CUSTOMIZADO -->
    <link rel="stylesheet" href="/css/_tokens.css">
    <!-- Estilo do perfil -->
    <link rel="stylesheet" href="/css/style-perfil.css">
</head>
<body>
    <div class="profile-page-container">
        <div class="profile-full-card">
            <!-- HEADER BANNER -->
            <div class="profile-header-banner">
                <div class="profile-avatar-wrapper">
                    <div class="profile-avatar">
                        👤
                    </div>
                    <div class="avatar-badge">
                        <i class="bi bi-check"></i>
                    </div>
                </div>

                <div class="profile-header-info">
                    <h1><%= user ? user.cliNome : 'Usuário' %></h1>
                    <div class="profile-subtitle">
                        <i class="bi bi-envelope"></i>
                        <span><%= user ? user.cliEmail : 'email@exemplo.com' %></span>
                    </div>
                </div>

                <div class="profile-header-actions">
                    <a href="/perfil/editar" class="btn-header">
                        <i class="bi bi-pencil-square"></i>
                        Editar Perfil
                    </a>
                    <a href="/" class="btn-header">
                        <i class="bi bi-shop"></i>
                        Loja
                    </a>
                    <a href="/pos-venda/online" class="btn-header" id="btnPerfilPosVenda">
                        <i class="bi bi-arrow-left-right"></i>
                        Devolução/Troca
                    </a>
                    <a href="/login/" class="btn-header btn-logout" id="logoutBtn">
                        <i class="bi bi-box-arrow-right"></i>
                        Sair
                    </a>
                </div>
            </div>

            <!-- MAIN CONTENT -->
            <div class="profile-content">
                <!-- STATS ROW -->
                <div class="profile-stats-row">
                    <div class="stat-card">
                        <div class="stat-icon red">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <div class="stat-info">
                            <h3>Status</h3>
                            <p>
                                <% if (user && user.cliStatus == 1) { %>
                                    <span class="status-badge active">
                                        <span class="status-dot"></span>
                                        Ativo
                                    </span>
                                <% } else { %>
                                    <span class="status-badge inactive">
                                        <span class="status-dot"></span>
                                        Inativo
                                    </span>
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="stat-info">
                            <h3>Perfil</h3>
                            <p>
                                <% if (user && user.perfilId == 3) { %>
                                    Administrador
                                <% } else { %>
                                    Cliente
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon teal">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div class="stat-info">
                            <h3>Membro Desde</h3>
                            <p>
                                <% if (user && user.cliNascimento) { %>
                                    2025
                                <% } else { %>
                                    —
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon yellow">
                            <i class="bi bi-bag-check"></i>
                        </div>
                        <div class="stat-info">
                            <h3>Pedidos</h3>
                            <p>—</p>
                        </div>
                    </div>
                </div>

                <!-- SECTIONS GRID -->
                <div class="profile-sections-grid">
                    <!-- DADOS PESSOAIS -->
                    <div class="profile-section">
                        <div class="section-header">
                            <div class="section-header-left">
                                <i class="bi bi-person-circle"></i>
                                <h2>Dados Pessoais</h2>
                            </div>

                        </div>
                        <div class="section-body">
                            <div class="data-row">
                                <div class="data-label">Nome</div>
                                <div class="data-value"><%= user ? user.cliNome : '—' %></div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">CPF</div>
                                <div class="data-value">
                                    <% if (user && user.cliCpf) { 
                                        let cpf = String(user.cliCpf);
                                        if (cpf.length === 11) {
                                            cpf = cpf.slice(0,3) + '.' + cpf.slice(3,6) + '.' + cpf.slice(6,9) + '-' + cpf.slice(9);
                                        }
                                    %>
                                        <%= cpf %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">Nascimento</div>
                                <div class="data-value">
                                    <% if (user && user.cliNascimento) { 
                                        let d = new Date(user.cliNascimento);
                                        let dia = String(d.getDate()).padStart(2, '0');
                                        let mes = String(d.getMonth() + 1).padStart(2, '0');
                                        let ano = d.getFullYear();
                                    %>
                                        <%= dia + '/' + mes + '/' + ano %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">Telefone</div>
                                <div class="data-value">
                                    <% if (user && user.cliTelefone) {
                                        let tel = String(user.cliTelefone).replace(/\D/g, '');
                                        if (tel.length === 11) {
                                            tel = '(' + tel.slice(0,2) + ') ' + tel.slice(2,7) + '-' + tel.slice(7);
                                        }
                                    %>
                                        <%= tel %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ACESSO -->
                    <div class="profile-section">
                        <div class="section-header">
                            <div class="section-header-left">
                                <i class="bi bi-shield-lock"></i>
                                <h2>Acesso à Conta</h2>
                            </div>

                        </div>
                        <div class="section-body">
                            <div class="data-row">
                                <div class="data-label">E-mail</div>
                                <div class="data-value"><%= user ? user.cliEmail : '—' %></div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">Senha</div>
                                <div class="data-value">••••••••</div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">Status</div>
                                <div class="data-value">
                                    <% if (user && user.cliStatus == 1) { %>
                                        <span class="status-badge active">
                                            <span class="status-dot"></span>
                                            Conta Ativa
                                        </span>
                                    <% } else { %>
                                        <span class="status-badge inactive">
                                            <span class="status-dot"></span>
                                            Conta Inativa
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="data-row">
                                <div class="data-label">Tipo</div>
                                <div class="data-value">
                                    <% if (user && user.perfilId == 3) { %>
                                        <i class="bi bi-star-fill" style="color: var(--accent-yellow); margin-right: 6px;"></i>Administrador
                                    <% } else { %>
                                        <i class="bi bi-person-fill" style="color: var(--teal); margin-right: 6px;"></i>Cliente
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ENDEREÇO -->
                    <div class="profile-section full-width">
                        <div class="section-header">
                            <div class="section-header-left">
                                <i class="bi bi-geo-alt"></i>
                                <h2>Endereço de Entrega</h2>
                            </div>

                        </div>
                        <div class="section-body">
                            <% if (user && user.endRua) { %>
                                <div class="address-card">
                                    <div class="address-icon-wrap">
                                        <i class="bi bi-house-door"></i>
                                    </div>
                                    <div class="address-details">
                                        <div class="address-line">
                                            <%= user.endRua %><% if (user.endNum) { %>, nº <%= user.endNum %><% } %>
                                        </div>
                                        <% if (user.endComplemento) { %>
                                            <div class="address-line">
                                                <span>Complemento:</span> <%= user.endComplemento %>
                                            </div>
                                        <% } %>
                                        <div class="address-line">
                                            <span>Bairro:</span> <%= user.endBairro || '—' %>
                                        </div>
                                        <div class="address-line">
                                            <%= user.endCidade || '—' %> — <%= user.endEstado || '' %> (<%= user.endUf || '' %>)
                                        </div>
                                        <div class="address-line">
                                            <span>CEP:</span> 
                                            <% if (user.endCep) {
                                                let cep = String(user.endCep).replace(/\D/g, '');
                                                if (cep.length === 8) {
                                                    cep = cep.slice(0,5) + '-' + cep.slice(5);
                                                }
                                            %>
                                                <%= cep %>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="address-card">
                                    <div class="address-icon-wrap">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    <div class="address-details">
                                        <div class="address-line" style="color: var(--text-light);">
                                            Nenhum endereço cadastrado.
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- DANGER ZONE -->
                <div class="danger-zone">
                    <div class="danger-zone-header">
                        <i class="bi bi-exclamation-triangle"></i>
                        <h3>Zona de Perigo</h3>
                    </div>
                    <p>Ações irreversíveis que afetam permanentemente sua conta. Tenha certeza antes de prosseguir.</p>
                    <button type="button" class="btn-danger-action" id="deleteAccountBtn">
                        <i class="bi bi-trash3"></i>
                        Excluir Minha Conta
                    </button>
                </div>
            </div>

            <!-- BACK LINK -->
            <div class="back-link-row">
                <a href="/">
                    <i class="bi bi-arrow-left"></i>
                    Voltar para a loja
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const deleteAccountBtn = document.getElementById("deleteAccountBtn");
            if (deleteAccountBtn) {
                deleteAccountBtn.addEventListener("click", function() {
                    Swal.fire({
                        title: "Tem certeza?",
                        text: "Esta ação é permanente e todos os seus dados e endereço serão excluídos irreversivelmente!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#dc3545", // Bootstrap Red
                        cancelButtonColor: "#6c757d", // Bootstrap Secondary Grey
                        confirmButtonText: "Sim, excluir conta",
                        cancelButtonText: "Cancelar",
                        background: "#121214", // dark theme background consistent with tokio night
                        color: "#e1e1e6"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Show loading
                            Swal.fire({
                                title: "Processando...",
                                text: "Excluindo sua conta e limpando sua sessão...",
                                allowOutsideClick: false,
                                background: "#121214",
                                color: "#e1e1e6",
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });

                            // Perform delete request using fetch
                            fetch("/perfil/excluir", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.ok) {
                                    Swal.fire({
                                        title: "Conta Excluída!",
                                        text: data.msg,
                                        icon: "success",
                                        background: "#121214",
                                        color: "#e1e1e6",
                                        confirmButtonColor: "#20a59a",
                                        timer: 3000,
                                        timerProgressBar: true
                                    }).then(() => {
                                        window.location.href = "/";
                                    });
                                } else {
                                    Swal.fire({
                                        title: "Erro!",
                                        text: data.msg,
                                        icon: "error",
                                        background: "#121214",
                                        color: "#e1e1e6",
                                        confirmButtonColor: "#20a59a"
                                    });
                                }
                            })
                            .catch(error => {
                                console.error("Erro na exclusão:", error);
                                Swal.fire({
                                    title: "Erro!",
                                    text: "Houve um problema de rede ou erro interno no servidor.",
                                    icon: "error",
                                    background: "#121214",
                                    color: "#e1e1e6",
                                    confirmButtonColor: "#20a59a"
                                });
                            });
                        }
                    });
                });
            }
        });
    </script>
</body>
</html>