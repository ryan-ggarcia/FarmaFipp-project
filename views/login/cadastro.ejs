<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style-cad.css">
    <title>FarmaFipp - Cadastro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>
    <div class="signup-page-container">
        <div class="signup-full-card">
            <!-- HEADER -->
            <div class="signup-header-banner">
                <div class="logo-wrap">💊</div>
                <div class="header-text">
                    <h1>Crie sua Conta na FarmaFipp</h1>
                    <p>Junte-se a mais de 50 mil clientes satisfeitos e aproveite ofertas exclusivas!</p>
                </div>
            </div>

            <!-- BODY -->
            <div class="signup-content">
                <!-- PROGRESS BAR -->
                <div class="progress-bar-container">
                    <div class="progress">
                        <div class="progress-bar" id="progressBar" style="width: 0%"></div>
                    </div>
                    <div class="progress-text" id="progressText">0/12 campos preenchidos</div>
                </div>

                <!-- SUCCESS MESSAGE -->
                <div class="success-message" id="successMessage">
                    <i class="bi bi-check-circle"></i>
                    <span>Cadastro realizado com sucesso! 🎉 Bem-vindo à FarmaFipp!</span>
                </div>

                <!-- INFO BOX -->
                <div class="info-box">
                    <i class="bi bi-info-circle"></i>
                    <div>Todos os campos marcados com <span style="color: var(--primary-red); font-weight: 600;">*</span> são obrigatórios</div>
                </div>

                <!-- FORM -->
                <form id="signupForm" class="split-form-layout">
                    <!-- LADO ESQUERDO: DADOS PESSOAIS -->
                    <div class="form-side personal-side">
                        <!-- SEÇÃO 1: DADOS PESSOAIS -->
                        <div class="section-title">
                            <i class="bi bi-person-circle"></i>
                            Dados Pessoais
                        </div>

                        <div class="row g-3">
                            <!-- NOME COMPLETO -->
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>Nome Completo</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="text" 
                                            class="form-control" 
                                            id="fullName"
                                            placeholder="João da Silva Santos"
                                            required
                                        >
                                        <div class="success-checkmark" id="fullNameCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="fullNameError"></div>
                                </div>
                            </div>

                            <!-- CPF -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>CPF</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="text" 
                                            class="form-control" 
                                            id="cpf"
                                            placeholder="000.000.000-00"
                                            maxlength="14"
                                            required
                                        >
                                        <div class="success-checkmark" id="cpfCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="cpfError"></div>
                                </div>
                            </div>

                            <!-- DATA DE NASCIMENTO -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>Data de Nascimento</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="date" 
                                            class="form-control" 
                                            id="birthDate"
                                            required
                                        >
                                        <div class="success-checkmark" id="birthDateCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="birthDateError"></div>
                                </div>
                            </div>

                            <!-- TELEFONE -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>Telefone</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="tel" 
                                            class="form-control" 
                                            id="phone"
                                            placeholder="(11) 98765-4321"
                                            maxlength="15"
                                            required
                                        >
                                        <div class="success-checkmark" id="phoneCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="phoneError"></div>
                                </div>
                            </div>

                        </div>

                        <!-- SEÇÃO 2: ACESSO -->
                        <div class="section-divider"></div>
                        <div class="section-title">
                            <i class="bi bi-lock-circle"></i>
                            Acesso à Conta
                        </div>

                        <div class="row g-3">
                            <!-- EMAIL -->
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>E-mail</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="email" 
                                            class="form-control" 
                                            id="email"
                                            placeholder="seu@email.com"
                                            required
                                        >
                                        <div class="success-checkmark" id="emailCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="emailError"></div>
                                </div>
                            </div>

                            <!-- SENHA -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>Senha</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="password" 
                                            class="form-control" 
                                            id="password"
                                            placeholder="••••••••"
                                            required
                                        >
                                        <button type="button" class="password-toggle" data-target="password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <div class="success-checkmark" id="passwordCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="password-strength" id="passwordStrength">
                                        <div class="password-strength-bar" id="passwordStrengthBar"></div>
                                    </div>
                                    <div class="password-strength-text" id="passwordStrengthText"></div>
                                    <div class="error-message" id="passwordError"></div>
                                </div>
                            </div>

                            <!-- CONFIRMAR SENHA -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <span>Confirmar Senha</span>
                                        <span class="required">*</span>
                                    </label>
                                    <div class="form-group-relative">
                                        <input 
                                            type="password" 
                                            class="form-control" 
                                            id="confirmPassword"
                                            placeholder="••••••••"
                                            required
                                        >
                                        <button type="button" class="password-toggle" data-target="confirmPassword">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <div class="success-checkmark" id="confirmPasswordCheck">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <div class="error-message" id="confirmPasswordError"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LADO DIREITO: ENDEREÇO -->
                    <div class="form-side address-side">
                        <!-- SEÇÃO 3: ENDEREÇO -->
                        <div class="section-title">
                            <i class="bi bi-map-circle"></i>
                            Endereço de Entrega
                        </div>

                        <div class="address-section">
                            <div class="row g-3">
                                <!-- CEP -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>CEP</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="cep-search">
                                            <div class="form-group-relative" style="flex: 1;">
                                                <input 
                                                    type="text" 
                                                    class="form-control" 
                                                    id="cep"
                                                    placeholder="00000-000"
                                                    maxlength="9"
                                                    required
                                                >
                                                <div class="success-checkmark" id="cepCheck">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-search-cep" id="searchCepBtn">
                                                <i class="bi bi-search me-1"></i>Buscar
                                            </button>
                                        </div>
                                        <div class="cep-loading" id="cepLoading">
                                            <i class="bi bi-hourglass-split me-1"></i>Buscando endereço...
                                        </div>
                                        <div class="error-message" id="cepError"></div>
                                    </div>
                                </div>

                                <!-- RUA/AVENIDA -->
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Rua / Avenida</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <input 
                                                type="text" 
                                                class="form-control" 
                                                id="street"
                                                placeholder="Rua dos Anjos"
                                                required
                                            >
                                            <div class="success-checkmark" id="streetCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="streetError"></div>
                                    </div>
                                </div>

                                <!-- NÚMERO -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Número</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <input 
                                                type="text" 
                                                class="form-control" 
                                                id="number"
                                                placeholder="123"
                                                required
                                            >
                                            <div class="success-checkmark" id="numberCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="numberError"></div>
                                    </div>
                                </div>

                                <!-- COMPLEMENTO -->
                                <div class="col-md-9">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Complemento (Apto, Bloco, etc)</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <input 
                                                type="text" 
                                                class="form-control" 
                                                id="complement"
                                                placeholder="Apto 42, Bloco B"
                                            >
                                        </div>
                                    </div>
                                </div>

                                <!-- BAIRRO -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Bairro</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <input 
                                                type="text" 
                                                class="form-control" 
                                                id="neighborhood"
                                                placeholder="Centro"
                                                required
                                            >
                                            <div class="success-checkmark" id="neighborhoodCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="neighborhoodError"></div>
                                    </div>
                                </div>

                                <!-- CIDADE -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Cidade</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <input 
                                                type="text" 
                                                class="form-control" 
                                                id="city"
                                                placeholder="São Paulo"
                                                required
                                            >
                                            <div class="success-checkmark" id="cityCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="cityError"></div>
                                    </div>
                                </div>

                                <!-- ESTADO (Nome completo) -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>Estado</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <select class="form-control" id="state" required>
                                                <option value="">Selecione o estado</option>
                                                <option value="Acre">Acre</option>
                                                <option value="Alagoas">Alagoas</option>
                                                <option value="Amapá">Amapá</option>
                                                <option value="Amazonas">Amazonas</option>
                                                <option value="Bahia">Bahia</option>
                                                <option value="Ceará">Ceará</option>
                                                <option value="Distrito Federal">Distrito Federal</option>
                                                <option value="Espírito Santo">Espírito Santo</option>
                                                <option value="Goiás">Goiás</option>
                                                <option value="Maranhão">Maranhão</option>
                                                <option value="Mato Grosso">Mato Grosso</option>
                                                <option value="Mato Grosso do Sul">Mato Grosso do Sul</option>
                                                <option value="Minas Gerais">Minas Gerais</option>
                                                <option value="Pará">Pará</option>
                                                <option value="Paraíba">Paraíba</option>
                                                <option value="Paraná">Paraná</option>
                                                <option value="Pernambuco">Pernambuco</option>
                                                <option value="Piauí">Piauí</option>
                                                <option value="Rio de Janeiro">Rio de Janeiro</option>
                                                <option value="Rio Grande do Norte">Rio Grande do Norte</option>
                                                <option value="Rio Grande do Sul">Rio Grande do Sul</option>
                                                <option value="Rondônia">Rondônia</option>
                                                <option value="Roraima">Roraima</option>
                                                <option value="Santa Catarina">Santa Catarina</option>
                                                <option value="São Paulo">São Paulo</option>
                                                <option value="Sergipe">Sergipe</option>
                                                <option value="Tocantins">Tocantins</option>
                                            </select>
                                            <div class="success-checkmark" id="stateCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="stateError"></div>
                                    </div>
                                </div>

                                <!-- UF (Sigla do Estado) -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <span>UF</span>
                                            <span class="required">*</span>
                                        </label>
                                        <div class="form-group-relative">
                                            <select class="form-control" id="uf" required>
                                                <option value="">Selecione a sigla</option>
                                                <option value="AC">AC - Acre</option>
                                                <option value="AL">AL - Alagoas</option>
                                                <option value="AP">AP - Amapá</option>
                                                <option value="AM">AM - Amazonas</option>
                                                <option value="BA">BA - Bahia</option>
                                                <option value="CE">CE - Ceará</option>
                                                <option value="DF">DF - Distrito Federal</option>
                                                <option value="ES">ES - Espírito Santo</option>
                                                <option value="GO">GO - Goiás</option>
                                                <option value="MA">MA - Maranhão</option>
                                                <option value="MT">MT - Mato Grosso</option>
                                                <option value="MS">MS - Mato Grosso do Sul</option>
                                                <option value="MG">MG - Minas Gerais</option>
                                                <option value="PA">PA - Pará</option>
                                                <option value="PB">PB - Paraíba</option>
                                                <option value="PR">PR - Paraná</option>
                                                <option value="PE">PE - Pernambuco</option>
                                                <option value="PI">PI - Piauí</option>
                                                <option value="RJ">RJ - Rio de Janeiro</option>
                                                <option value="RN">RN - Rio Grande do Norte</option>
                                                <option value="RS">RS - Rio Grande do Sul</option>
                                                <option value="RO">RO - Rondônia</option>
                                                <option value="RR">RR - Roraima</option>
                                                <option value="SC">SC - Santa Catarina</option>
                                                <option value="SP">SP - São Paulo</option>
                                                <option value="SE">SE - Sergipe</option>
                                                <option value="TO">TO - Tocantins</option>
                                            </select>
                                            <div class="success-checkmark" id="ufCheck">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </div>
                                        </div>
                                        <div class="error-message" id="ufError"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ÁREA DE AÇÕES -->
                    <div class="form-actions-area">
                        <!-- BOTÃO CADASTRAR -->
                        <button type="button" class="btn-signup" id="signupBtn">
                            <i class="bi bi-check-circle me-2"></i>Criar Conta
                        </button>

                        <!-- LOGIN LINK -->
                        <div class="login-link">
                            Já tem conta? <a href="/login/">Faça login aqui</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/cadScripts/cad.js"></script>
</body>
</html>