<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FarmaFipp - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-login.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="row g-0 h-100">
                <!-- LEFT SIDE -->
                <div class="col-lg-5 login-left">
                    <div class="logo-section">
                        <div class="logo">💊</div>
                        <div class="logo-text">FarmaFipp</div>
                    </div>

                    <div class="left-content">
                        <h2 class="left-title">FarmaFipp é sua farmácia online confiável</h2>
                        <p class="left-desc">Medicamentos, suplementos e cuidados pessoais entregues com qualidade e segurança na sua porta.</p>

                        <div class="feature-box">
                            <div class="feature-icon">⚡</div>
                            <div class="feature-title">Entrega Rápida</div>
                            <div class="feature-subtitle">Em todo o Brasil</div>
                        </div>

                        <div class="feature-box">
                            <div class="feature-icon">🔒</div>
                            <div class="feature-title">100% Seguro</div>
                            <div class="feature-subtitle">Pagamento protegido</div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDE -->
                <div class="col-lg-7 login-right">
                    <div class="welcome-header">
                        <div class="welcome-avatar">👤</div>
                        <h1 class="welcome-title">Bem-vindo(a)</h1>
                        <p class="welcome-subtitle">à FarmaFipp</p>
                    </div>

                    <!-- SUCCESS MESSAGE -->
                    <div class="success-message" id="successMessage">
                        <i class="bi bi-check-circle"></i>
                        <span>Login realizado com sucesso! 🎉</span>
                    </div>

                    <!-- USE FOR OPTIONS -->
                    <div class="use-for-label">Como você vai usar?</div>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" name="usefor" value="personal" checked>
                            <span class="radio-label">
                                <i class="bi bi-person"></i>
                                Pessoal
                            </span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="usefor" value="team">
                            <span class="radio-label">
                                <i class="bi bi-people"></i>
                                Para Negócio
                            </span>
                        </label>
                    </div>

                    <!-- FORM -->
                    <form id="loginForm">
                        <div class="form-group">
                            <label class="form-label">E-mail</label>
                            <input 
                                type="email" 
                                class="form-control" 
                                id="email"
                                placeholder="seu@email.com"
                                required
                            >
                            <div class="error-message" id="emailError"></div>
                        </div>

                        <div class="form-group form-group-password">
                            <label class="form-label">Senha</label>
                            <input 
                                type="password" 
                                class="form-control" 
                                id="password"
                                placeholder="••••••••"
                                required
                            >
                            <button type="button" class="password-toggle" id="passwordToggle">
                                <i class="bi bi-eye"></i>
                            </button>
                            <div class="error-message" id="passwordError"></div>
                        </div>

                        <button type="button" class="btn-login" id="loginBtn">Entrar</button>
                    </form>

                    <div class="forgot-password">
                        <a href="#" onclick="event.preventDefault(); alert('Redirecionando para recuperação de senha...')">
                            Esqueceu a senha?
                        </a>
                    </div>

                    <div class="login-footer">
                        <i class="bi bi-check-circle"></i>
                        <span>Mais de 50 mil clientes satisfeitos</span>
                    </div>

                    <div class="signup-prompt">
                        Não tem conta? <a href="/login/cadastro">Cadastre-se aqui</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/loginScripts/verificar.js"></script>

</body>
</html>