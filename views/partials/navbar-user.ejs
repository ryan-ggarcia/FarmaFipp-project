<!-- Modal Carrinho -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cartModalLabel"><i class="bi bi-bag me-2"></i>Meu Carrinho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0">
                <div id="cartModalEmpty" class="text-center py-5 d-none">
                    <i class="bi bi-bag-x" style="font-size:3rem;color:#b9b9b9;"></i>
                    <h6 class="mt-3">Seu carrinho está vazio</h6>
                    <p class="text-muted small">Adicione produtos para visualizar o resumo da compra.</p>
                </div>
                <div id="cartModalItems">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produto</th>
                                <th class="text-center">Qtd.</th>
                                <th class="text-end">Preço</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody id="cartModalBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer flex-column align-items-stretch gap-2" id="cartModalFooter">
                <div class="d-flex justify-content-between px-1">
                    <span class="text-muted">Total de itens:</span>
                    <strong id="cartModalTotalItems">0</strong>
                </div>
                <div class="d-flex justify-content-between px-1 mb-1">
                    <span class="text-muted">Total:</span>
                    <strong id="cartModalTotalPrice">R$ 0,00</strong>
                </div>
                <div class="d-grid gap-2">
                    <a href="/usuario/carrinho" class="btn btn-danger">
                        <i class="bi bi-bag-check me-1"></i> Finalizar compra
                    </a>
                    <button type="button" class="btn btn-outline-secondary" id="btnModalClearCart">
                        Limpar carrinho
                    </button>
                </div>
            </div>
        </div>
    </div>
