    <!-- Menu colapsável -->
    <div class="collapse navbar-collapse" id="mainNav">

      <!-- Links de navegação -->
      <ul class="navbar-nav me-auto gap-1 mt-3 mt-lg-0" id="mainNavLinks">
        <li class="nav-item">
          <a class="nav-link" href="/" data-nav-path="/" aria-current="page">Início</a>
