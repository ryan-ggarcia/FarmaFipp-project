<%
/* ── Usuário logado (disponível via res.locals.user no validarAdmin) ── */
var __user      = (typeof user !== 'undefined' && user) ? user : null;
var __userName  = __user && __user.cliNome  ? __user.cliNome  : 'Admin';
var __userEmail = __user && __user.cliEmail ? __user.cliEmail : '';
%>
<nav class="main-header navbar navbar-expand navbar-light bg-white shadow-sm">
  <div class="container-fluid px-3">

    <!-- Toggle da sidebar (AdminLTE data-widget="pushmenu") -->
    <button class="btn btn-sm btn-light rounded-circle me-2 border-0"
            data-widget="pushmenu"
            aria-label="Abrir/fechar menu lateral"
            title="Menu lateral">
      <i class="bi bi-list fs-5"></i>
    </button>

    <!-- Menu direito -->
    <ul class="navbar-nav ms-auto align-items-center gap-1">

      <!-- Notificações -->
      <li class="nav-item dropdown">
        <a class="nav-link position-relative px-2"
           data-bs-toggle="dropdown"
           href="#"
           aria-expanded="false"
           aria-label="Notificações">
          <i class="bi bi-bell fs-5 text-muted"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger navbar-badge-xs">3</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-notif-menu">
          <li><h6 class="dropdown-header">Notificações</h6></li>
          <li><hr class="dropdown-divider my-0"></li>
          <li>
            <a class="dropdown-item py-2 small text-muted" href="#">
              <i class="bi bi-info-circle me-2 text-primary"></i>
              Nenhuma notificação nova
            </a>
          </li>
        </ul>
      </li>

      <!-- Perfil — abre modal -->
      <li class="nav-item">
        <button type="button"
                class="btn nav-link d-flex align-items-center gap-2 px-2 border-0 bg-transparent"
                data-bs-toggle="modal"
                data-bs-target="#perfilModal"
                aria-label="Abrir perfil">
          <img src="/img/user.png"
               class="rounded-circle border border-2 border-light avatar-img"
               alt="Avatar do usuário"
               width="34"
               height="34">
          <span class="d-none d-lg-block fw-semibold small text-dark">
            <%= __userName.split(' ')[0] %>
          </span>
          <i class="bi bi-chevron-down small text-muted d-none d-lg-inline"></i>
        </button>
      </li>

    </ul>
  </div>
</nav>
