<%
/* Tenta capturar info do usuário logado; tolerante a undefined */
var __userName  = (typeof user  !== 'undefined' && user  && user.nome)   ? user.nome   : 'Admin';
var __userEmail = (typeof user  !== 'undefined' && user  && user.email)  ? user.email  : '';
var __userRole  = (typeof user  !== 'undefined' && user  && user.perfil) ? user.perfil : '—';
%>
<nav class="main-header navbar navbar-expand navbar-light bg-white shadow-sm">
  <div class="container-fluid px-3">

    <!-- Toggle da sidebar (AdminLTE data-widget="pushmenu") -->
    <button class="btn btn-sm btn-light rounded-circle me-2 border-0"
            data-widget="pushmenu"
            aria-label="Abrir/fechar menu lateral"
            title="Menu lateral">
      <i class="bi bi-list fs-5"></i>
    </button>

    <!-- Busca — oculta em telas xs, visível a partir de md -->
    <form class="d-none d-md-flex ms-2 flex-grow-1" style="max-width:440px"
          action="/search" method="GET" role="search">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0 rounded-start-pill text-muted">
          <i class="bi bi-search" aria-hidden="true"></i>
        </span>
        <input class="form-control border-start-0 bg-light rounded-end-pill"
               type="search"
               name="q"
               placeholder="Buscar produto, cliente…"
               aria-label="Busca">
      </div>
    </form>

    <!-- Menu direito -->
    <ul class="navbar-nav ms-auto align-items-center gap-1">

      <!-- Notificações -->
      <li class="nav-item dropdown">
        <a class="nav-link position-relative px-2"
           data-bs-toggle="dropdown"
           href="#"
           aria-expanded="false"
           aria-label="Notificações">
          <i class="bi bi-bell fs-5 text-muted"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                style="font-size:.6rem">3</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:240px">
          <li><h6 class="dropdown-header">Notificações</h6></li>
          <li><hr class="dropdown-divider my-0"></li>
          <li>
            <a class="dropdown-item py-2 small text-muted" href="#">
              <i class="bi bi-info-circle me-2 text-primary"></i>
              Nenhuma notificação nova
            </a>
          </li>
        </ul>
      </li>

      <!-- Perfil do usuário -->
      <li class="nav-item dropdown">
        <a class="nav-link d-flex align-items-center gap-2 px-2"
           data-bs-toggle="dropdown"
           href="#"
           aria-label="Menu do usuário">
          <img src="/img/user.png"
               class="rounded-circle border border-2 border-light"
               alt="Avatar do usuário"
               width="34"
               height="34"
               style="object-fit:cover">
          <span class="d-none d-lg-block fw-semibold small text-dark">
            <%= __userName.split(' ')[0] %>
          </span>
          <i class="bi bi-chevron-down small text-muted d-none d-lg-inline"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:220px">

          <!-- Info do usuário no topo do dropdown -->
          <li class="px-3 py-2">
            <div class="fw-semibold small text-dark lh-1"><%= __userName %></div>
            <% if(__userEmail){ %>
            <div class="text-muted" style="font-size:.75rem;margin-top:.2rem"><%= __userEmail %></div>
            <% } %>
          </li>
          <li><hr class="dropdown-divider my-1"></li>

          <li>
            <a class="dropdown-item py-2 small" href="/perfil">
              <i class="bi bi-person me-2 text-secondary"></i> Meu Perfil
            </a>
          </li>
          <li>
            <a class="dropdown-item py-2 small" href="#">
              <i class="bi bi-gear me-2 text-secondary"></i> Configurações
            </a>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <a class="dropdown-item py-2 small text-danger fw-semibold" href="/logout">
              <i class="bi bi-box-arrow-right me-2"></i> Sair
            </a>
          </li>

        </ul>
      </li>

    </ul>
  </div>
</nav>
