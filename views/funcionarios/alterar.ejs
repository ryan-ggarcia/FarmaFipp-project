<script src="/js/funcionarios/alterar.js"></script>

<div class="p-3 p-1-25">

  <!-- ── Dados do Funcionário ── -->
  <div class="card card-saas no-hover mb-3">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-pencil-square me-2"></i>Alterar Dados do Funcionário
      </h4>

      <!-- ID oculto -->
      <input type="hidden" id="funcId" value="<%= funcionario.funcId %>">

      <div class="row g-3">

        <div class="col-md-4">
          <label class="form-label">Matrícula</label>
          <input type="text" id="funcMatricula" class="form-control"
                 value="<%= funcionario.funcMatricula %>" placeholder="Matrícula">
        </div>

        <div class="col-md-4">
          <label class="form-label">Cargo</label>
          <input type="text" id="funcCargo" class="form-control"
                 value="<%= funcionario.funcCargo %>" placeholder="Cargo">
        </div>

        <div class="col-md-4">
          <label class="form-label">Nome</label>
          <input type="text" id="funcNome" class="form-control"
                 value="<%= funcionario.funcNome %>" placeholder="Nome completo">
        </div>

        <div class="col-md-4">
          <label class="form-label">CPF</label>
          <input type="text" id="funcCpf" class="form-control"
                 value="<%= funcionario.funcCpf %>" placeholder="000.000.000-00">
        </div>

        <div class="col-md-4">
          <label class="form-label">Telefone</label>
          <input type="text" id="funcTelefone" class="form-control"
                 value="<%= funcionario.funcTelefone %>" placeholder="(00) 00000-0000">
        </div>

        <div class="col-md-4">
          <label class="form-label">E-mail</label>
          <input type="email" id="funcEmail" class="form-control"
                 value="<%= funcionario.funcEmail %>" placeholder="email@exemplo.com">
        </div>

        <div class="col-md-4">
          <label class="form-label">Senha</label>
          <input type="password" id="funcSenha" class="form-control"
                 value="<%= funcionario.funcSenha %>" placeholder="••••••••">
        </div>

      </div>
    </div>
  </div>

  <!-- ── Endereço ── -->
  <div class="card card-saas no-hover">
    <div class="card-body">
      <h4 class="mb-3 admin-section-title">
        <i class="bi bi-geo-alt me-2"></i>Alterar Endereço
      </h4>

      <!-- ID do endereço oculto -->
      <input type="hidden" id="endId" value="<%= funcionario.endId %>">

      <div class="row g-3">

        <div class="col-md-4">
          <label class="form-label">Rua</label>
          <input type="text" id="endRua" class="form-control"
                 value="<%= funcionario.endRua %>" placeholder="Nome da rua">
        </div>

        <div class="col-md-4">
          <label class="form-label">Número</label>
          <input type="text" id="endNum" class="form-control"
                 value="<%= funcionario.endNum %>" placeholder="Nº">
        </div>

        <div class="col-md-4">
          <label class="form-label">Bairro</label>
          <input type="text" id="endBairro" class="form-control"
                 value="<%= funcionario.endBairro %>" placeholder="Bairro">
        </div>

        <div class="col-md-4">
          <label class="form-label">Cidade</label>
          <input type="text" id="endCidade" class="form-control"
                 value="<%= funcionario.endCidade %>" placeholder="Cidade">
        </div>

        <div class="col-md-4">
          <label class="form-label">Estado</label>
          <input type="text" id="endEstado" class="form-control"
                 value="<%= funcionario.endEstado %>" placeholder="Estado">
        </div>

        <div class="col-md-4">
          <label class="form-label">UF</label>
          <input type="text" id="endUf" class="form-control" maxlength="2"
                 value="<%= funcionario.endUf %>" placeholder="SP">
        </div>

        <div class="col-md-4">
          <label class="form-label">CEP</label>
          <input type="text" id="endCep" class="form-control"
                 value="<%= funcionario.endCep %>" placeholder="00000-000">
        </div>

        <div class="col-12 d-flex gap-2 mt-1">
          <button id="btnAlterar" type="button"
                  class="btn btn-primary custom btn-rounded">
            <i class="fas fa-save me-1"></i>Salvar Alterações
          </button>
          <a href="/admin/funcionarios/listar" class="btn btn-outline-secondary btn-rounded">
            <i class="fas fa-arrow-left me-1"></i>Voltar
          </a>
        </div>

      </div>
    </div>
  </div>

</div>
