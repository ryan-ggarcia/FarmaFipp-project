<script src="/js/funcionarios/alterar.js"></script>
<div>
    <h1>Alterar dados do funcionário</h1>
    <div>
        <div class="form-group">
            <input type="hidden" id="funcId" value="<%= funcionario.funcId %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcMatricula" value="<%= funcionario.funcMatricula %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcCargo" value="<%= funcionario.funcCargo %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcNome" value="<%= funcionario.funcNome %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcCpf" value="<%= funcionario.funcCpf %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcTelefone" value="<%= funcionario.funcTelefone %>">
        </div>
        <div class="form-group">
            <input type="text" id="funcEmail" value="<%= funcionario.funcEmail %>">
        </div>
        <div class="form-group">
            <input type="password" id="funcSenha" value="<%= funcionario.funcSenha %>">
        </div>
        <div>
            <button id="btnAlterar" class="btn btn-primary">Alterar</button>
            <a href="/funcionarios/listar">Voltar</a>
        </div>        
    </div>