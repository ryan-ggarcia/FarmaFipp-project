<script src="/js/funcionarios/listar.js"></script>
<div>
    <h1>Lista de Funcionários</h1>
    <div>
        <a class="btn btn-primary" href="/funcionarios/cadastrar"><i class="fas fa-plus"></i> Cadastrar Novo Funcionário</a>
    </div>
    <br>
    <div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Matrícula</th>
                    <th>Cargo</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>CPF</th>
                </tr>
            </thead>
            <tbody>
                <% lista.forEach(function(func){ %>
                    <tr>
                        <td><%= func.funcId %></td>
                        <td><%= func.funcMatricula %></td>
                        <td><%= func.funcCargo %></td>
                        <td><%= func.funcNome %></td>
                        <td><%= func.funcTelefone %></td>
                        <td><%= func.funcEmail %></td>
                        <td><%= func.funcCpf %></td>
                        <td>
                             <button data-id="<%= func.funcId %>" class="btn btn-info btnDetalhes">
                    <i class="fas fa-eye"></i>
                            </button>
                            <a href="/funcionarios/alterar/<%= func.funcId %>" class="btn btn-primary">
                                <i class="fas fa-pen"></i>
                            </a>
                            <button data-id="<%= func.funcId %>" class="btn btn-danger btnExcluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr class="detalhes" id="detalhes-<%= func.funcId %>" style="display: none;">
                        <td colspan="10">
                            <strong>Endereço:</strong><br>
                            Rua: <%= func.endRua %><br>
                            Bairro: <%= func.endBairro %><br>
                            Cidade: <%= func.endCidade %><br>
                            Número: <%= func.endNum %><br>
                            Estado: <%= func.endEstado %><br>
                            UF: <%= func.endUf %><br>
                            CEP: <%= func.endCep %><br>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<script>
    document.querySelectorAll('.btnDetalhes').forEach(btn => {
        btn.addEventListener('click', function () {
            let id = this.getAttribute('data-id');
            let linha = document.getElementById('detalhes-' + id);

            if (linha.style.display === 'none') {
                linha.style.display = 'table-row';
            } else {
                linha.style.display = 'none';
            }
        });
    });
</script>
