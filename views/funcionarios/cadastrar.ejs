<script src="/js/funcionarios/cadastrar.js"></script>
<div>
    <h1>Cadastrar Cliente</h1>
    <div>
        <div class="form-group">
            <label>Matricula:</label>
            <input id="matricula" type="text" class="form-control">
        </div>
        <div class="form-group">
            <label>Nome:</label>
            <input id="nome" type="text" class="form-control">
        </div>
        <div class="form-group">
            <label>Cargo:</label>
            <input id="cargo" type="text" class="form-control">
        </div>
    <div class="form-group">
        <label>CPF:</label>
        <input id="cpf" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Telefone:</label>
        <input id="telefone" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Email:</label>
        <input id="email" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Senha:</label>
        <input id="senha" type="password" class="form-control">
    </div>
</div>

<div>
    <h1>Cadastrar endereco</h1>
    <div>
    <div class="form-group">
        <label>CEP:</label>
        <input id="cep" type="text" class="form-control">
    </div>
        <div class="form-group">
            <label>Rua:</label>
            <input id="rua" type="text" class="form-control">
        </div>
        <div class="form-group">
            <label>Número:</label>
            <input id="num" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Complemento:</label>
        <input id="complemento" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Bairro:</label>
        <input id="bairro" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Cidade:</label>
        <input id="cidade" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>Estado:</label>
        <input id="estado" type="text" class="form-control">
    </div>
    <div class="form-group">
        <label>UF:</label>
        <input id="uf" type="text" class="form-control">
    </div>
    <button class="btn btn-primary" id="btnCadastrar">Cadastrar</button>
