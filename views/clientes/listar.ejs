<script src="/js/clientes/listar.js"></script>
<div>
    <h1>Lista de Clientes</h1>
    <div>
        <a class="btn btn-primary" href="/clientes/cadastrar"><i class="fas fa-plus"></i> Cadastrar Novo Cliente</a>
    </div>
    <br>
    <div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Status</th>
                    <th>CPF</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Data de Nascimento</th>
                    <th>Perfil</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% lista.forEach(function(c){ %>
                    <tr>
                        <td><%= c.cliId %></td>
                        <td><%= c.cliNome %></td>
                        <td><%= c.cliStatus ? 'Ativo' : 'Inativo' %></td>
                        <td><%= c.cliCpf %></td>
                        <td><%= c.cliEmail %></td>
                        <td><%= c.cliTelefone %></td>
                        <td><%= new Date(c.cliNascimento).toLocaleDateString('pt-BR') %></td>
                        <td>
                            <%= c.perfilId == 1 ? 'Cliente' : c.perfilId == 2 ? 'Funcionario' : (c.perfilId || '-') %>
                        </td>
                        <td>
                            <button data-id="<%= c.cliId %>" class="btn btn-info btnDetalhes">
                    <i class="fas fa-eye"></i>
                            </button>
                            <a href="/clientes/alterar/<%= c.cliId %>" class="btn btn-primary">
                                <i class="fas fa-pen"></i>
                            </a>
                            <button data-id="<%= c.cliId %>" class="btn btn-danger btnExcluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr class="detalhes" id="detalhes-<%= c.cliId %>" style="display: none;">
                        <td colspan="10">
                            <strong>Endereço:</strong><br>
                            Rua: <%= c.endRua %><br>
                            Bairro: <%= c.endBairro %><br>
                            Cidade: <%= c.endCidade %><br>
                            Número: <%= c.endNum %><br>
                            Estado: <%= c.endEstado %><br>
                            UF: <%= c.endUf %><br>
                            CEP: <%= c.endCep %><br>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<script>
    document.querySelectorAll('.btnDetalhes').forEach(btn => {
        btn.addEventListener('click', function () {
            let id = this.getAttribute('data-id');
            let linha = document.getElementById('detalhes-' + id);

            if (linha.style.display === 'none') {
                linha.style.display = 'table-row';
            } else {
                linha.style.display = 'none';
            }
        });
    });
</script>