<script src="/js/clientes/listar.js"></script>
<div class="p-3 p-1-25">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Clientes cadastrados</h3>
            <small class="text-muted">Gerencie os clientes registrados no sistema</small>
        </div>
        <div>
            <a class="btn btn-primary custom btn-rounded" href="/admin/clientes/cadastrar"><i class="fas fa-plus me-2"></i>
                Cadastrar Clientes</a>
        </div>
    </div>
    <div class="card card-saas ">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Status</th>
                            <th>CPF</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Data de Nascimento</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lista.forEach(function(c){ %>
                            <tr>
                                <td>
                                    <%= c.cliId %>
                                </td>
                                <td>
                                    <%= c.cliNome %>
                                </td>
                                <td>
                                    <%= c.cliStatus ? 'Ativo' : 'Inativo' %>
                                </td>
                                <td>
                                    <%= c.cliCpf %>
                                </td>
                                <td>
                                    <%= c.cliEmail %>
                                </td>
                                <td>
                                    <%= c.cliTelefone %>
                                </td>
                                <td>
                                    <%= new Date(c.cliNascimento).toLocaleDateString('pt-BR') %>
                                </td>
                                <td>
                                    <button data-id="<%= c.cliId %>" class="btn btn-sm btn-info btn-rounded btnDetalhes">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a href="/admin/clientes/alterar/<%= c.cliId %>" class="btn btn-sm btn-primary btn-rounded">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <button data-id="<%= c.cliId %>" class="btn btn-sm btn-danger btnExcluir btn-rounded">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="detalhes" id="detalhes-<%= c.cliId %>" style="display: none;">
                                <td colspan="8">
                                    <strong>Endereço:</strong><br>
                                    Rua: <%= c.endRua %><br>
                                        Bairro: <%= c.endBairro %><br>
                                            Cidade: <%= c.endCidade %><br>
                                                Número: <%= c.endNum %><br>
                                                    Estado: <%= c.endEstado %><br>
                                                        UF: <%= c.endUf %><br>
                                                            CEP: <%= c.endCep %><br>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</div>
<script>
    document.querySelectorAll('.btnDetalhes').forEach(btn => {
        btn.addEventListener('click', function () {
            let id = this.getAttribute('data-id');
            let linha = document.getElementById('detalhes-' + id);

            if (linha.style.display === 'none') {
                linha.style.display = 'table-row';
            } else {
                linha.style.display = 'none';
            }
        });
    });
</script>