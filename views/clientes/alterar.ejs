<script src="/js/clientes/alterar.js"></script>
<div>
    <h1>Alterar dados do cliente</h1>
    <div>
        <div class="form-group">
            <input type="hidden" id="cliId" value="<%= cliente.cliId %>">
        </div>
        <div class="form-group">
            <input type="text" id="cliNome" value="<%= cliente.cliNome %>">
        </div>
        <div class="form-group">
            <select id="cliStatus" value="<%=cliente.cliStatus %>">
                <option value="1" <%= cliente.cliStatus ? 'selected' : '' %>>Ativo</option>
                <option value="0" <%= !cliente.cliStatus ? 'selected' : '' %>>Inativo</option>
            </select>
        </div>
        <div class="form-group">
            <input type="text" id="cliCpf" value="<%= cliente.cliCpf %>">
        </div>
        <div class="form-group">
            <input type="text" id="cliTelefone" value="<%= cliente.cliTelefone %>">
        </div>
        <div class="form-group">
            <input type="text" id="cliEmail" value="<%= cliente.cliEmail %>">
        </div>
        <div class="form-group">
            <input type="password" id="cliSenha" value="<%= cliente.cliSenha %>">
        </div>
        <div class="form-group">
            <input type="date" id="cliNascimento" value="<%= cliente.cliNascimento %>">
        </div>
    </div>
    <h1>Alterar Endereço</h1>
    <div>
        <div class="form-group">
            <input type="hidden" id="endId" value="<%= cliente.endId %>">
        </div>
        <div class="form-group">
            <input type="text" id="endRua" value="<%= cliente.endRua %>">
        </div>
        <div class="form-group">
            <input type="text" id="endBairro" value="<%= cliente.endBairro %>">
        </div>
        <div class="form-group">
            <input type="text" id="endNum" value="<%= cliente.endNum %>">
        </div>
        <div class="form-group">
            <input type="text" id="endCidade" value="<%= cliente.endCidade %>">
        </div>
        <div class="form-group">
            <input type="text" id="endEstado" value="<%= cliente.endEstado %>">
        </div>
        <div class="form-group">
            <input type="text" id="endUf" value="<%= cliente.endUf %>">
        </div>
        <div class="form-group">
            <input type="text" id="endCep" value="<%= cliente.endCep %>">
        </div>
        <div>
            <button id="btnAlterar" class="btn btn-primary">Alterar</button>
            <a href="/admin/clientes/listar">Voltar</a>
        </div>
    </div>
</div>