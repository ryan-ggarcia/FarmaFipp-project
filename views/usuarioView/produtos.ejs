<%
const produtosLista = Array.isArray(lista) ? lista : [];
const categoriasLista = Array.isArray(categorias) ? categorias : [];
const totalProdutos = produtosLista.length;
const promoData = (typeof promoMap !== 'undefined' && promoMap) ? promoMap : {};

const promoIds = new Set();
if (Array.isArray(produtosPromocao)) {
    produtosPromocao.forEach(function (p) {
        var pid = p.id != null ? p.id : (p.pro_id != null ? p.pro_id : p.produto_id);
        if (pid != null) promoIds.add(String(pid));
    });
}
%>

<!-- ════════════════════════════════
     SHOP HERO
════════════════════════════════ -->
<div class="shop-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/">Início</a></li>
                <li class="breadcrumb-item active" aria-current="page">Produtos</li>
            </ol>
        </nav>
        <h1>Todos os Produtos</h1>
        <p class="subtitle">
            <i class="bi bi-box-seam me-1"></i>
            Encontre os melhores medicamentos, suplementos e cuidados pessoais
        </p>
    </div>
</div>

<!-- ════════════════════════════════
     FILTERS BAR
════════════════════════════════ -->
<div class="container">
    <div class="filters-bar">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="search-wrap">
                    <i class="bi bi-search search-icon"></i>
                    <input
                        id="searchInput"
                        class="form-control"
                        type="search"
                        placeholder="Buscar por nome ou categoria..."
                    />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select id="categoryFilter" class="form-select">
                    <option value="">Todas as categorias</option>
                    <% categoriasLista.forEach(function (categoria) { %>
                        <option value="<%= (categoria.nome || '').toLowerCase() %>"><%= categoria.nome %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select id="sortFilter" class="form-select">
                    <option value="name">Nome A-Z</option>
                    <option value="name-desc">Nome Z-A</option>
                    <option value="price-asc">Menor preço</option>
                    <option value="price-desc">Maior preço</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn-filter-promo" id="btnFilterPromo" type="button">
                    <i class="bi bi-tag-fill me-1"></i>Promoções
                </button>
            </div>
            <div class="col-auto">
                <button class="btn-reset" id="btnResetFilters" type="button">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Limpar
                </button>
            </div>
            <div class="col-auto ms-auto">
                <span class="result-count">
                    <span id="visibleCount"><%= totalProdutos %></span> de <%= totalProdutos %> produtos
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════
     PRODUCTS GRID
════════════════════════════════ -->
<div class="container pb-5">
    <% if (totalProdutos === 0) { %>
        <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <h4>Nenhum produto cadastrado</h4>
            <p>Os produtos registrados no sistema aparecerão aqui.</p>
        </div>
    <% } else { %>
        <div class="row g-3" id="productsGrid">
            <% produtosLista.forEach(function (produto) {
                var produtoId = produto.id != null ? produto.id : (produto.pro_id != null ? produto.pro_id : produto.produto_id);
                var nome = produto.nome || 'Produto sem nome';
                var descricao = produto.descricao || '';
                var categoria = produto.categoria || 'Sem categoria';
                var marca = produto.marca || 'Sem marca';
                var fornecedor = produto.fornecedor || '';
                var lote = produto.lote || '';
                var quantidade = Number(produto.quantidade || 0);
                var preco = Number(produto.preco || 0);
                var imagem = (produto.img && produto.img !== 'Imagem não disponível')
                    ? produto.img
                    : '/img/produtos/imagem.png';
                var isPromo = promoIds.has(String(produtoId));
                var promoInfo = promoData[String(produtoId)];
                var precoOriginal = promoInfo ? Number(promoInfo.precoOriginal) : preco;
                var precoPromo = promoInfo ? Number(promoInfo.precoPromocional) : preco;
                var porcentagem = promoInfo ? Number(promoInfo.porcentagem) : 0;
            %>
                <div
                    class="col-12 col-sm-6 col-lg-4 col-xl-3 product-col"
                    data-product-name="<%= nome.toLowerCase() %>"
                    data-product-category="<%= categoria.toLowerCase() %>"
                    data-product-price="<%= isPromo ? precoPromo : preco %>"
                    data-is-promo="<%= isPromo ? 'true' : 'false' %>"
                >
                    <article class="shop-product-card<%= isPromo ? ' card-promo-highlight' : '' %>">
                        <!-- Badge -->
                        <% if (isPromo) { %>
                            <span class="card-badge card-badge-promo"><i class="bi bi-tag-fill me-1"></i>-<%= porcentagem %>%</span>
                        <% } else if (quantidade <= 0) { %>
                            <span class="card-badge card-badge-esgotado">Esgotado</span>
                        <% } else if (quantidade <= 10) { %>
                            <span class="card-badge card-badge-ultimas">Últimas unid.</span>
                        <% } %>

                        <!-- Wishlist -->
                        <button class="wishlist-btn" title="Favoritar"><i class="bi bi-heart"></i></button>

                        <a href="/produto/<%= produtoId %>" class="card-link">
                            <!-- Image -->
                            <div class="card-img-area">
                                <img src="<%= imagem %>" alt="<%= nome %>" />
                            </div>

                            <!-- Info -->
                            <div class="card-info">
                                <div class="card-brand"><%= marca %></div>
                                <div class="card-title"><%= nome %></div>
                                <div class="card-category">
                                    <i class="bi bi-grid"></i> <%= categoria %>
                                </div>

                                <% if (descricao) { %>
                                    <p class="card-desc">
                                        <%= descricao.length > 60 ? descricao.substring(0, 60) + '…' : descricao %>
                                    </p>
                                <% } %>

                                <div class="card-details">
                                    <span class="detail-chip"><i class="bi bi-boxes"></i> Estoque: <strong><%= quantidade %></strong></span>
                                    <% if (fornecedor) { %>
                                        <span class="detail-chip"><i class="bi bi-building"></i> <%= fornecedor %></span>
                                    <% } %>
                                </div>

                                <div class="card-price-row">
                                    <% if (isPromo && promoInfo) { %>
                                        <div class="price-promo-wrap">
                                            <span class="price-original">R$ <%= precoOriginal.toFixed(2) %></span>
                                            <span class="price-promo">R$ <%= precoPromo.toFixed(2) %></span>
                                        </div>
                                    <% } else { %>
                                        <span class="price-current">R$ <%= preco.toFixed(2) %></span>
                                    <% } %>
                                    <% if (produto.validade) { %>
                                        <span class="price-validity">Val: <%= new Date(produto.validade).toLocaleDateString('pt-BR') %></span>
                                    <% } %>
                                </div>
                            </div>
                        </a>
                    </article>
                </div>
            <% }); %>
        </div>

        <!-- No results message -->
        <div id="noResultsMsg">
            <i class="bi bi-search d-block mb-2"></i>
            <strong>Nenhum produto encontrado</strong>
            <p class="mb-0 mt-1">Tente ajustar os filtros ou buscar por outro termo.</p>
        </div>
    <% } %>
</div>

<script>
(function () {
    var grid = document.getElementById('productsGrid');
    var searchInput = document.getElementById('searchInput');
    var categoryFilter = document.getElementById('categoryFilter');
    var sortFilter = document.getElementById('sortFilter');
    var btnReset = document.getElementById('btnResetFilters');
    var btnPromo = document.getElementById('btnFilterPromo');
    var visibleCount = document.getElementById('visibleCount');
    var noResults = document.getElementById('noResultsMsg');

    if (!grid) return;

    var cards = Array.from(grid.querySelectorAll('.product-col'));
    var promoFilterActive = false;

    function normalizeStr(s) {
        return (s || '').toLowerCase()
            .normalize('NFD').replace(/[̀-ͯ]/g, '')
            .replace(/&/g, 'e')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }

    // Pré-aplica filtros vindos da URL
    var urlParams = new URLSearchParams(window.location.search);

    var urlCat = urlParams.get('categoria');
    if (urlCat && categoryFilter) {
        var normalizedParam = normalizeStr(urlCat);
        for (var i = 0; i < categoryFilter.options.length; i++) {
            if (normalizeStr(categoryFilter.options[i].value) === normalizedParam) {
                categoryFilter.value = categoryFilter.options[i].value;
                break;
            }
        }
    }

    var urlBusca = urlParams.get('busca');
    if (urlBusca && searchInput) {
        searchInput.value = urlBusca;
    }

    var urlFiltro = urlParams.get('filtro');
    if (urlFiltro === 'promocao') {
        promoFilterActive = true;
        if (btnPromo) btnPromo.classList.add('active');
    }

    function updateCount() {
        var visible = cards.filter(function (c) { return c.style.display !== 'none'; }).length;
        if (visibleCount) visibleCount.textContent = String(visible);
        if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    function applyFilters() {
        var term = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var category = (categoryFilter ? categoryFilter.value : '').toLowerCase();

        cards.forEach(function (card) {
            var name = (card.dataset.productName || '').toLowerCase();
            var itemCat = (card.dataset.productCategory || '').toLowerCase();
            var isPromo = card.dataset.isPromo === 'true';
            var matchName = !term || name.includes(term) || itemCat.includes(term);
            var matchCategory = !category || itemCat === category;
            var matchPromo = !promoFilterActive || isPromo;
            card.style.display = (matchName && matchCategory && matchPromo) ? '' : 'none';
        });

        updateCount();
    }

    function sortCards() {
        var mode = sortFilter ? sortFilter.value : 'name';
        var sorted = cards.slice().sort(function (a, b) {
            var nameA = (a.dataset.productName || '').toLowerCase();
            var nameB = (b.dataset.productName || '').toLowerCase();
            var priceA = Number(a.dataset.productPrice || 0);
            var priceB = Number(b.dataset.productPrice || 0);

            if (mode === 'name') return nameA.localeCompare(nameB);
            if (mode === 'name-desc') return nameB.localeCompare(nameA);
            if (mode === 'price-asc') return priceA - priceB;
            if (mode === 'price-desc') return priceB - priceA;
            return 0;
        });

        sorted.forEach(function (card) {
            grid.appendChild(card);
        });
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (categoryFilter) categoryFilter.addEventListener('change', applyFilters);
    if (sortFilter) {
        sortFilter.addEventListener('change', function () {
            sortCards();
            applyFilters();
        });
    }

    // Botão filtro de promoções
    if (btnPromo) {
        btnPromo.addEventListener('click', function() {
            promoFilterActive = !promoFilterActive;
            btnPromo.classList.toggle('active', promoFilterActive);
            applyFilters();
        });
    }

    if (btnReset) {
        btnReset.addEventListener('click', function () {
            if (searchInput) searchInput.value = '';
            if (categoryFilter) categoryFilter.value = '';
            if (sortFilter) sortFilter.value = 'name';
            promoFilterActive = false;
            if (btnPromo) btnPromo.classList.remove('active');
            sortCards();
            applyFilters();
        });
    }

    // Wishlist toggle
    grid.addEventListener('click', function(e) {
        var wishBtn = e.target.closest('.wishlist-btn');
        if (wishBtn) {
            var icon = wishBtn.querySelector('i');
            icon.classList.toggle('bi-heart');
            icon.classList.toggle('bi-heart-fill');
            wishBtn.style.color = icon.classList.contains('bi-heart-fill') ? 'var(--primary-red)' : '';
        }
    });

    sortCards();
    applyFilters();
})();
</script>
