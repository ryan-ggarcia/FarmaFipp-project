<%
const produtosLista = Array.isArray(lista) ? lista : [];
const categoriasLista = Array.isArray(categorias) ? categorias : [];
const totalProdutos = produtosLista.length;

const promoIds = new Set();
if (Array.isArray(produtosPromocao)) {
    produtosPromocao.forEach(function (p) {
        var pid = p.id != null ? p.id : (p.pro_id != null ? p.pro_id : p.produto_id);
        if (pid != null) promoIds.add(String(pid));
    });
}
%>

<style>
/* ════════════════════════════════
   SHOP PAGE – Premium Design
════════════════════════════════ */
.shop-hero {
    background: linear-gradient(135deg, #1a4731 0%, #2D6A4F 55%, #3a8a66 100%);
    border-radius: 0 0 24px 24px;
    padding: 2.5rem 0 2rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
}
.shop-hero::before {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    top: -80px;
    right: -60px;
}
.shop-hero::after {
    content: '';
    position: absolute;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(255,255,255,.04);
    bottom: -40px;
    left: 10%;
}
.shop-hero .breadcrumb {
    margin-bottom: .5rem;
}
.shop-hero .breadcrumb-item a {
    color: rgba(255,255,255,.7);
    text-decoration: none;
    font-size: .88rem;
}
.shop-hero .breadcrumb-item a:hover { color: #fff; }
.shop-hero .breadcrumb-item.active { color: rgba(255,255,255,.5); font-size: .88rem; }
.shop-hero .breadcrumb-item+.breadcrumb-item::before { color: rgba(255,255,255,.4); }
.shop-hero h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 2.2rem;
    color: #F4D35E;
    margin-bottom: .3rem;
}
.shop-hero .subtitle {
    color: rgba(255,255,255,.75);
    font-size: .95rem;
    font-weight: 300;
}

/* ── Filters bar ── */
.filters-bar {
    background: #fff;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,.06);
    margin-bottom: 2rem;
    margin-top: -2rem;
    position: relative;
    z-index: 5;
}
.filters-bar .form-control,
.filters-bar .form-select {
    border-radius: 10px;
    border: 1.5px solid #e8e8e8;
    font-size: .88rem;
    padding: .55rem 1rem;
    transition: border-color .2s, box-shadow .2s;
}
.filters-bar .form-control:focus,
.filters-bar .form-select:focus {
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(78,128,152,.12);
}
.filters-bar .btn-reset {
    background: transparent;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    color: #888;
    font-size: .85rem;
    font-weight: 600;
    padding: .55rem 1.2rem;
    transition: all .2s;
}
.filters-bar .btn-reset:hover {
    border-color: var(--primary-red);
    color: var(--primary-red);
    background: rgba(163,22,33,.04);
}
.filters-bar .result-count {
    font-size: .82rem;
    color: #999;
    font-weight: 500;
}

/* ── Product Grid Card ── */
.shop-product-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.05);
    transition: transform .25s cubic-bezier(.4,0,.2,1), box-shadow .25s;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.shop-product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0,0,0,.1);
}

/* Image area */
.shop-product-card .card-img-area {
    background: linear-gradient(135deg, #f5f7fa 0%, #e8edf2 100%);
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
}
.shop-product-card .card-img-area img {
    max-height: 150px;
    max-width: 100%;
    object-fit: contain;
    transition: transform .3s cubic-bezier(.4,0,.2,1);
    filter: drop-shadow(0 4px 12px rgba(0,0,0,.08));
}
.shop-product-card:hover .card-img-area img {
    transform: scale(1.08);
}

/* Badges */
.shop-product-card .card-badge {
    position: absolute;
    top: .75rem;
    left: .75rem;
    padding: .25rem .7rem;
    border-radius: 8px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .04em;
    z-index: 2;
}
.card-badge-promo { background: linear-gradient(135deg, #ff4757, #ff6b81); color: #fff; }
.card-badge-esgotado { background: #636e72; color: #fff; }
.card-badge-ultimas { background: linear-gradient(135deg, #f9ca24, #f0932b); color: #333; }

/* Wishlist */
.shop-product-card .wishlist-btn {
    position: absolute;
    top: .65rem;
    right: .65rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,.9);
    backdrop-filter: blur(8px);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .9rem;
    color: #bbb;
    cursor: pointer;
    transition: all .2s;
    z-index: 2;
}
.shop-product-card .wishlist-btn:hover {
    color: var(--primary-red);
    background: #fff;
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
}

/* Card body */
.shop-product-card .card-info {
    padding: 1.1rem 1.2rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}
.shop-product-card .card-brand {
    font-size: .7rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: .2rem;
}
.shop-product-card .card-title {
    font-size: .92rem;
    font-weight: 700;
    color: #222;
    line-height: 1.35;
    margin-bottom: .35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.shop-product-card .card-category {
    font-size: .76rem;
    color: #888;
    margin-bottom: .6rem;
    display: flex;
    align-items: center;
    gap: .3rem;
}

/* Details row */
.shop-product-card .card-details {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-bottom: .75rem;
}
.shop-product-card .detail-chip {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    background: #f0f4f8;
    border-radius: 6px;
    padding: .2rem .55rem;
    font-size: .72rem;
    color: #555;
    font-weight: 500;
}
.detail-chip i { font-size: .7rem; color: #999; }

/* Price row */
.shop-product-card .card-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    margin-bottom: .6rem;
}
.shop-product-card .price-current {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary-red);
    font-family: 'Syne', sans-serif;
}
.shop-product-card .price-validity {
    font-size: .72rem;
    color: #aaa;
}

/* Add to cart */
.shop-product-card .btn-cart-add {
    width: 100%;
    background: linear-gradient(135deg, var(--primary-red), #c02030);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: .55rem;
    font-size: .85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
}
.shop-product-card .btn-cart-add:hover {
    background: linear-gradient(135deg, #8b1019, #a31621);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(163,22,33,.25);
}
.shop-product-card .btn-cart-add:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}
.btn-cart-add.added {
    background: linear-gradient(135deg, #2D6A4F, #3a8a66) !important;
}

/* Empty state */
.empty-state {
    background: #fff;
    border-radius: 20px;
    padding: 4rem 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,.05);
    text-align: center;
}
.empty-state i {
    font-size: 4rem;
    color: #ddd;
    margin-bottom: 1rem;
}
.empty-state h4 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    color: #444;
}
.empty-state p { color: #999; }

/* ── No results message ── */
#noResultsMsg {
    display: none;
    text-align: center;
    padding: 3rem 1rem;
    color: #888;
}
#noResultsMsg i { font-size: 2.5rem; color: #ddd; }
</style>

<!-- ════════════════════════════════
     SHOP HERO
════════════════════════════════ -->
<div class="shop-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/">Início</a></li>
                <li class="breadcrumb-item active" aria-current="page">Produtos</li>
            </ol>
        </nav>
        <h1>Todos os Produtos</h1>
        <p class="subtitle">
            <i class="bi bi-box-seam me-1"></i>
            Encontre os melhores medicamentos, suplementos e cuidados pessoais
        </p>
    </div>
</div>

<!-- ════════════════════════════════
     FILTERS BAR
════════════════════════════════ -->
<div class="container">
    <div class="filters-bar">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute" style="left: .85rem; top: 50%; transform: translateY(-50%); color: #aaa; font-size: .85rem"></i>
                    <input
                        id="searchInput"
                        class="form-control"
                        type="search"
                        placeholder="Buscar por nome ou categoria..."
                        style="padding-left: 2.4rem"
                    />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select id="categoryFilter" class="form-select">
                    <option value="">Todas as categorias</option>
                    <% categoriasLista.forEach(function (categoria) { %>
                        <option value="<%= (categoria.nome || '').toLowerCase() %>"><%= categoria.nome %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select id="sortFilter" class="form-select">
                    <option value="name">Nome A-Z</option>
                    <option value="name-desc">Nome Z-A</option>
                    <option value="price-asc">Menor preço</option>
                    <option value="price-desc">Maior preço</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn-reset" id="btnResetFilters" type="button">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Limpar
                </button>
            </div>
            <div class="col-auto ms-auto">
                <span class="result-count">
                    <span id="visibleCount"><%= totalProdutos %></span> de <%= totalProdutos %> produtos
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════
     PRODUCTS GRID
════════════════════════════════ -->
<div class="container pb-5">
    <% if (totalProdutos === 0) { %>
        <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <h4>Nenhum produto cadastrado</h4>
            <p>Os produtos registrados no sistema aparecerão aqui.</p>
        </div>
    <% } else { %>
        <div class="row g-3" id="productsGrid">
            <% produtosLista.forEach(function (produto) {
                var produtoId = produto.id != null ? produto.id : (produto.pro_id != null ? produto.pro_id : produto.produto_id);
                var idLote = produto.id_lote != null ? produto.id_lote : (produto.idLote != null ? produto.idLote : produto.lot_id);
                var nome = produto.nome || 'Produto sem nome';
                var descricao = produto.descricao || '';
                var categoria = produto.categoria || 'Sem categoria';
                var marca = produto.marca || 'Sem marca';
                var fornecedor = produto.fornecedor || '';
                var lote = produto.lote || '';
                var quantidade = Number(produto.quantidade || 0);
                var preco = Number(produto.preco || 0);
                var imagem = (produto.img && produto.img !== 'Imagem não disponível')
                    ? produto.img
                    : '/img/produtos/imagem.png';
                var isPromo = promoIds.has(String(produtoId));
            %>
                <div
                    class="col-12 col-sm-6 col-lg-4 col-xl-3 product-col"
                    data-product-name="<%= nome.toLowerCase() %>"
                    data-product-category="<%= categoria.toLowerCase() %>"
                    data-product-price="<%= preco %>"
                >
                    <article class="shop-product-card">
                        <!-- Badge -->
                        <% if (isPromo) { %>
                            <span class="card-badge card-badge-promo"><i class="bi bi-tag-fill me-1"></i>Promoção</span>
                        <% } else if (quantidade <= 0) { %>
                            <span class="card-badge card-badge-esgotado">Esgotado</span>
                        <% } else if (quantidade <= 10) { %>
                            <span class="card-badge card-badge-ultimas">Últimas unid.</span>
                        <% } %>

                        <!-- Wishlist -->
                        <button class="wishlist-btn" title="Favoritar"><i class="bi bi-heart"></i></button>

                        <!-- Image -->
                        <div class="card-img-area">
                            <img src="<%= imagem %>" alt="<%= nome %>" />
                        </div>

                        <!-- Info -->
                        <div class="card-info">
                            <div class="card-brand"><%= marca %></div>
                            <div class="card-title"><%= nome %></div>
                            <div class="card-category">
                                <i class="bi bi-grid"></i> <%= categoria %>
                            </div>

                            <% if (descricao) { %>
                                <p style="font-size:.8rem; color:#888; line-height:1.4; margin-bottom:.6rem">
                                    <%= descricao.length > 60 ? descricao.substring(0, 60) + '…' : descricao %>
                                </p>
                            <% } %>

                            <div class="card-details">
                                <span class="detail-chip"><i class="bi bi-boxes"></i> Estoque: <strong><%= quantidade %></strong></span>
                                <% if (lote) { %>
                                    <span class="detail-chip"><i class="bi bi-upc-scan"></i> <%= lote %></span>
                                <% } %>
                                <% if (fornecedor) { %>
                                    <span class="detail-chip"><i class="bi bi-building"></i> <%= fornecedor %></span>
                                <% } %>
                            </div>

                            <div class="card-price-row">
                                <span class="price-current">R$ <%= preco.toFixed(2) %></span>
                                <% if (produto.validade) { %>
                                    <span class="price-validity">Val: <%= new Date(produto.validade).toLocaleDateString('pt-BR') %></span>
                                <% } %>
                            </div>

                            <button
                                class="btn-cart-add add-to-cart"
                                type="button"
                                data-produto="<%= produtoId %>"
                                data-lote="<%= idLote || '' %>"
                                <%= quantidade <= 0 ? 'disabled' : '' %>
                            >
                                <i class="bi bi-bag-plus"></i>
                                <%= quantidade <= 0 ? 'Indisponível' : 'Adicionar ao carrinho' %>
                            </button>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>

        <!-- No results message -->
        <div id="noResultsMsg">
            <i class="bi bi-search d-block mb-2"></i>
            <strong>Nenhum produto encontrado</strong>
            <p class="mb-0 mt-1">Tente ajustar os filtros ou buscar por outro termo.</p>
        </div>
    <% } %>
</div>

<script src="/js/produtos/cartService.js"></script>
<script>
(function () {
    var grid = document.getElementById('productsGrid');
    var searchInput = document.getElementById('searchInput');
    var categoryFilter = document.getElementById('categoryFilter');
    var sortFilter = document.getElementById('sortFilter');
    var btnReset = document.getElementById('btnResetFilters');
    var visibleCount = document.getElementById('visibleCount');
    var noResults = document.getElementById('noResultsMsg');

    if (!grid) return;

    var cards = Array.from(grid.querySelectorAll('.product-col'));

    function updateCount() {
        var visible = cards.filter(function (c) { return c.style.display !== 'none'; }).length;
        if (visibleCount) visibleCount.textContent = String(visible);
        if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    function applyFilters() {
        var term = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var category = (categoryFilter ? categoryFilter.value : '').toLowerCase();

        cards.forEach(function (card) {
            var name = (card.dataset.productName || '').toLowerCase();
            var itemCat = (card.dataset.productCategory || '').toLowerCase();
            var matchName = !term || name.includes(term) || itemCat.includes(term);
            var matchCategory = !category || itemCat === category;
            card.style.display = (matchName && matchCategory) ? '' : 'none';
        });

        updateCount();
    }

    function sortCards() {
        var mode = sortFilter ? sortFilter.value : 'name';
        var sorted = cards.slice().sort(function (a, b) {
            var nameA = (a.dataset.productName || '').toLowerCase();
            var nameB = (b.dataset.productName || '').toLowerCase();
            var priceA = Number(a.dataset.productPrice || 0);
            var priceB = Number(b.dataset.productPrice || 0);

            if (mode === 'name') return nameA.localeCompare(nameB);
            if (mode === 'name-desc') return nameB.localeCompare(nameA);
            if (mode === 'price-asc') return priceA - priceB;
            if (mode === 'price-desc') return priceB - priceA;
            return 0;
        });

        sorted.forEach(function (card) {
            grid.appendChild(card);
        });
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (categoryFilter) categoryFilter.addEventListener('change', applyFilters);
    if (sortFilter) {
        sortFilter.addEventListener('change', function () {
            sortCards();
            applyFilters();
        });
    }

    if (btnReset) {
        btnReset.addEventListener('click', function () {
            if (searchInput) searchInput.value = '';
            if (categoryFilter) categoryFilter.value = '';
            if (sortFilter) sortFilter.value = 'name';
            sortCards();
            applyFilters();
        });
    }

    // Wishlist toggle
    grid.addEventListener('click', function(e) {
        var wishBtn = e.target.closest('.wishlist-btn');
        if (wishBtn) {
            var icon = wishBtn.querySelector('i');
            icon.classList.toggle('bi-heart');
            icon.classList.toggle('bi-heart-fill');
            wishBtn.style.color = icon.classList.contains('bi-heart-fill') ? 'var(--primary-red)' : '';
        }
    });

    // Add to cart animation
    grid.addEventListener('click', function(e) {
        var cartBtn = e.target.closest('.btn-cart-add');
        if (cartBtn && !cartBtn.disabled) {
            var orig = cartBtn.innerHTML;
            cartBtn.innerHTML = '<i class="bi bi-check-circle"></i> Adicionado!';
            cartBtn.classList.add('added');
            setTimeout(function () {
                cartBtn.innerHTML = orig;
                cartBtn.classList.remove('added');
            }, 1500);
        }
    });

    sortCards();
    applyFilters();
})();
</script>
