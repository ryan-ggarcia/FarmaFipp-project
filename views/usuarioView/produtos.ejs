<link rel="stylesheet" href="/css/style-produtos.css" />
<div class="page-header">
    <div class="container-xl">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Início</a></li>
                        <li class="breadcrumb-item active">Produtos</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-baseline gap-3">
                    <h1 class="page-title">Todos os Produtos</h1>
                    <span class="result-count">
                        <!-- result aqui -->
                    </span>
                </div>
            </div>
            <button class="btn-filter-mobile" id="btnFilterMobile">
                <i class="bi bi-sliders"></i> Filtros
            </button>
        </div>
    </div>
</div>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- ══ LAYOUT ══ -->
<div class="container-xl">
    <div class="products-layout">

        <!-- SIDEBAR -->
        <aside class="filters-sidebar" id="filtersSidebar">
            <button class="sidebar-close-btn" id="btnCloseSidebar"><i class="bi bi-x-lg"></i></button>

            <div class="filter-card">
                <div class="filter-card-body">
                    <div style="position:relative">
                        <i class="bi bi-search"
                            style="position:absolute;left:.75rem;top:50%;transform:translateY(-50%);color:#bbb;font-size:.82rem"></i>
                        <input type="text" id="searchInput" placeholder="Buscar produto…"
                            style="width:100%;border:1.5px solid #eee;border-radius:8px;padding:.45rem .75rem .45rem 2.2rem;font-size:.84rem" />
                    </div>
                </div>
            </div>

            <div class="filter-card">
                <div class="filter-card-header" data-bs-toggle="collapse" data-bs-target="#catFilter">
                    <span><i class="bi bi-grid-3x3-gap me-2 text-muted"></i>Categorias</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size:.8rem"></i>
                </div>
                <div class="collapse show" id="catFilter">
                    <div class="filter-card-body">
                        <div class="filter-check"><input type="checkbox" id="cat1" checked /><label for="cat1">Vitaminas
                                & Minerais</label><span class="count">48</span></div>
                        <div class="filter-check"><input type="checkbox" id="cat2" /><label
                                for="cat2">Dermatologia</label><span class="count">36</span></div>
                        <div class="filter-check"><input type="checkbox" id="cat3" /><label
                                for="cat3">Suplementos</label><span class="count">29</span></div>
                        <div class="filter-check"><input type="checkbox" id="cat4" /><label for="cat4">Higiene
                                Pessoal</label><span class="count">54</span></div>
                        <div class="filter-check"><input type="checkbox" id="cat5" /><label for="cat5">Bebê &
                                Mamãe</label><span class="count">22</span></div>
                        <div class="filter-check"><input type="checkbox" id="cat6" /><label for="cat6">Saúde
                                Cardíaca</label><span class="count">17</span></div>
                    </div>
                </div>
            </div>

            <div class="filter-card">
                <div class="filter-card-header" data-bs-toggle="collapse" data-bs-target="#priceFilter">
                    <span><i class="bi bi-tag me-2 text-muted"></i>Faixa de Preço</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size:.8rem"></i>
                </div>
                <div class="collapse show" id="priceFilter">
                    <div class="filter-card-body">
                        <div class="price-range-display">
                            <span id="priceMin">R$ 0</span>
                            <span id="priceMax">R$ 300</span>
                        </div>
                        <input type="range" id="priceRange" min="0" max="300" value="300" step="5" />
                        <div class="d-flex gap-2 mt-2">
                            <input type="number" placeholder="Mín"
                                style="width:50%;border:1.5px solid #eee;border-radius:8px;padding:.35rem .6rem;font-size:.8rem" />
                            <input type="number" placeholder="Máx"
                                style="width:50%;border:1.5px solid #eee;border-radius:8px;padding:.35rem .6rem;font-size:.8rem" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="filter-card">
                <div class="filter-card-header" data-bs-toggle="collapse" data-bs-target="#brandFilter">
                    <span><i class="bi bi-award me-2 text-muted"></i>Marcas</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size:.8rem"></i>
                </div>
                <div class="collapse show" id="brandFilter">
                    <div class="filter-card-body">
                        <div class="filter-check"><input type="checkbox" id="b1" /><label for="b1">VitaPlus</label><span
                                class="count">21</span></div>
                        <div class="filter-check"><input type="checkbox" id="b2" /><label
                                for="b2">DermaClin</label><span class="count">14</span></div>
                        <div class="filter-check"><input type="checkbox" id="b3" /><label
                                for="b3">NaturVital</label><span class="count">18</span></div>
                        <div class="filter-check"><input type="checkbox" id="b4" /><label for="b4">HelioVit</label><span
                                class="count">9</span></div>
                        <div class="filter-check"><input type="checkbox" id="b5" /><label for="b5">OmegaVit</label><span
                                class="count">12</span></div>
                    </div>
                </div>
            </div>

            <div class="filter-card">
                <div class="filter-card-header" data-bs-toggle="collapse" data-bs-target="#ratingFilter">
                    <span><i class="bi bi-star me-2 text-muted"></i>Avaliação</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size:.8rem"></i>
                </div>
                <div class="collapse show" id="ratingFilter">
                    <div class="filter-card-body">
                        <div class="star-filter"><span class="stars">★★★★★</span> 5 estrelas <span
                                class="count ms-auto">12</span></div>
                        <div class="star-filter"><span class="stars">★★★★☆</span> 4+ estrelas <span
                                class="count ms-auto">31</span></div>
                        <div class="star-filter"><span class="stars">★★★☆☆</span> 3+ estrelas <span
                                class="count ms-auto">48</span></div>
                    </div>
                </div>
            </div>

            <button class="btn-clear-filters"><i class="bi bi-x-circle me-1"></i>Limpar Filtros</button>
        </aside>

        <!-- ÁREA DE PRODUTOS -->
        <div class="products-area">

            <div class="active-filters">
                <span class="filter-tag">Vitaminas <button>×</button></span>
                <span class="filter-tag">Até R$ 300 <button>×</button></span>
            </div>

            <div class="products-toolbar">
                <span class="toolbar-label">Ordenar por:</span>
                <select class="toolbar-select">
                    <option>Relevância</option>
                    <option>Menor Preço</option>
                    <option>Maior Preço</option>
                    <option>Mais Vendidos</option>
                    <option>Novidades</option>
                    <option>Melhor Avaliado</option>
                </select>
                <span class="toolbar-label ms-2">Exibir:</span>
                <select class="toolbar-select" style="width:70px">
                    <option>24</option>
                    <option>48</option>
                    <option>96</option>
                </select>
                <div class="view-toggle ms-auto">
                    <button class="view-btn active" id="btnGrid" title="Grade"><i
                            class="bi bi-grid-3x3-gap-fill"></i></button>
                    <button class="view-btn" id="btnList" title="Lista"><i class="bi bi-list-ul"></i></button>
                </div>
            </div>
            <!-- parte de grid -->
            <nav class="mt-4 d-flex justify-content-center" aria-label="Paginação">
                <ul class="pagination">
                    <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">…</a></li>
                    <li class="page-item"><a class="page-link" href="#">8</a></li>
                    <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </nav>

        </div><!-- /.products-area -->
    </div><!-- /.products-layout -->
</div><!-- /.container-xl -->

<%- include('../partials/footer') %>

    <script>
        /* ── Sidebar mobile ── */
        const sidebar = document.getElementById('filtersSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const btnOpen = document.getElementById('btnFilterMobile');
        const btnClose = document.getElementById('btnCloseSidebar');

        const openSidebar = () => { sidebar.classList.add('open'); backdrop.classList.add('show'); };
        const closeSidebar = () => { sidebar.classList.remove('open'); backdrop.classList.remove('show'); };

        btnOpen?.addEventListener('click', openSidebar);
        btnClose?.addEventListener('click', closeSidebar);
        backdrop?.addEventListener('click', closeSidebar);

        /* ── Grade / Lista ── */
        const grid = document.getElementById('productsGrid');
        const btnGrid = document.getElementById('btnGrid');
        const btnList = document.getElementById('btnList');

        btnGrid.addEventListener('click', () => {
            grid.classList.remove('list-view');
            btnGrid.classList.add('active'); btnList.classList.remove('active');
            grid.querySelectorAll('[class*="col-"]').forEach(c => {
                c.className = c.className.replace(/col-xl-\d+/, 'col-xl-3');
            });
        });
        btnList.addEventListener('click', () => {
            grid.classList.add('list-view');
            btnList.classList.add('active'); btnGrid.classList.remove('active');
            grid.querySelectorAll('[class*="col-"]').forEach(c => {
                if (!c.id) c.className = c.className.replace(/col-xl-\d+/, 'col-xl-12');
            });
        });

        /* ── Wishlist ── */
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const ico = this.querySelector('i');
                ico.classList.toggle('bi-heart');
                ico.classList.toggle('bi-heart-fill');
                this.classList.toggle('active');
            });
        });

        /* ── Carrinho ── */
        document.querySelectorAll('.btn-add-cart').forEach(btn => {
            btn.addEventListener('click', function () {
                const orig = this.innerHTML;
                this.innerHTML = '<i class="bi bi-check-circle"></i> Adicionado!';
                this.classList.add('added'); this.disabled = true;
                setTimeout(() => { this.innerHTML = orig; this.classList.remove('added'); this.disabled = false; }, 1800);
            });
        });

        /* ── Range de preço ── */
        const range = document.getElementById('priceRange');
        const priceMax = document.getElementById('priceMax');
        range?.addEventListener('input', () => { priceMax.textContent = 'R$ ' + range.value; });

        /* ── Busca client-side ── */
        document.getElementById('searchInput')?.addEventListener('input', function () {
            const term = this.value.toLowerCase();
            const cards = document.querySelectorAll('#productsGrid > [class*="col-"]:not(#emptyState)');
            let visible = 0;
            cards.forEach(col => {
                const show = col.querySelector('.prod-title')?.textContent.toLowerCase().includes(term);
                col.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            document.getElementById('emptyState').classList.toggle('d-none', visible > 0);
        });
    </script>