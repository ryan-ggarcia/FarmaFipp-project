<!-- ════════════════════════════════
     PAGE: PRODUTOS – USER VIEW
════════════════════════════════ -->
<link rel="stylesheet" href="/css/style-produtos-user.css">

<!-- Hero Banner -->
<div class="produtos-hero">
    <div class="container position-relative" style="z-index:2">
        <span class="hero-badge"><i class="bi bi-bag-heart me-1"></i> Nosso Catálogo</span>
        <h1>Nossos Produtos</h1>
        <p>Encontre medicamentos, suplementos, dermocosméticos e muito mais com os melhores preços.</p>
    </div>
</div>

<!-- Tabs + Filter Bar -->
<div class="container">
    <div class="filter-bar">
        <!-- Tabs -->
        <div class="produto-tabs mb-3">
            <button class="produto-tab active" data-tab="todos" onclick="switchTab('todos')">
                <i class="bi bi-grid me-1"></i> Todos
            </button>
            <button class="produto-tab" data-tab="promocao" onclick="switchTab('promocao')">
                <i class="bi bi-tag-fill me-1"></i> Promoção
                <% if(produtosPromocao && produtosPromocao.length> 0) { %>
                    <span class="tab-count">
                        <%= produtosPromocao.length %>
                    </span>
                    <% } %>
            </button>
        </div>

        <!-- Filters -->
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute"
                        style="left:1rem;top:50%;transform:translateY(-50%);color:#aaa;font-size:.85rem"></i>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar produtos..."
                        style="padding-left:2.5rem" onkeyup="filterProducts()">
                </div>
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select" onchange="filterProducts()">
                    <option value="">Todas as categorias</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="sortFilter" class="form-select" onchange="sortProducts()">
                    <option value="name">Nome A-Z</option>
                    <option value="name-desc">Nome Z-A</option>
                    <option value="price-asc">Menor preço</option>
                    <option value="price-desc">Maior preço</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button class="btn-filter w-100" onclick="resetFilters()"><i
                        class="bi bi-arrow-counterclockwise me-1"></i>Limpar</button>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════
     TAB: TODOS OS PRODUTOS
════════════════════════════════ -->
<section class="products-section" id="tab-todos">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="products-count">
                <% if(produtos && produtos.length> 0) { %>
                    Exibindo <span id="visibleCount">
                        <%= produtos.length %>
                    </span> de <span>
                        <%= produtos.length %>
                    </span> produtos
                    <% } %>
            </div>
        </div>

        <% if(!produtos || produtos.length===0) { %>
            <div class="empty-state">
                <i class="bi bi-box-seam"></i>
                <h4>Nenhum produto encontrado</h4>
                <p>No momento não existem produtos cadastrados no sistema.</p>
                <a href="/" class="btn btn-hero mt-3" style="text-decoration:none">
                    <i class="bi bi-house me-1"></i> Voltar ao Início
                </a>
            </div>
            <% } else { %>
                <div class="row g-3" id="productsGrid">
                    <% for(let i=0; i < produtos.length; i++) { %>
                        <div class="col-6 col-md-4 col-lg-3" data-product
                            data-name="<%= produtos[i].nome.toLowerCase() %>"
                            data-category="<%= produtos[i].categoria %>" data-price="<%= produtos[i].preco %>">
                            <div class="product-card h-100">
                                <% if(produtos[i].quantidade <= 0) { %>
                                    <span class="badge-discount" style="background:#666">Esgotado</span>
                                    <% } else if(produtos[i].quantidade <=10) { %>
                                        <span class="badge-discount"
                                            style="background:var(--accent-yellow);color:#333">Últimas unid.</span>
                                        <% } %>

                                            <button class="wishlist-btn" title="Adicionar à lista de desejos">
                                                <i class="bi bi-heart"></i>
                                            </button>

                                            <div class="img-wrap">
                                                <% if(produtos[i].img && produtos[i].img !== 'Imagem não disponível') { %>
                                                    <img src="<%= produtos[i].img %>" alt="<%= produtos[i].nome %>"
                                                        class="product-db-img" />
                                                    <% } else { %>
                                                        <i class="bi bi-capsule"
                                                            style="font-size:3.5rem;color:rgba(0,0,0,.15)"></i>
                                                        <% } %>
                                            </div>

                                            <div class="card-body">
                                                <% if(produtos[i].marca && produtos[i].marca !== 'Marca não disponível') { %>
                                                    <div class="brand-tag">
                                                        <%= produtos[i].marca %>
                                                    </div>
                                                    <% } %>
                                                        <div class="prod-title">
                                                            <%= produtos[i].nome %>
                                                        </div>
                                                        <% if(produtos[i].descricao && produtos[i].descricao !== 'Descrição não disponível') { %>
                                                            <div class="product-desc">
                                                                <%= produtos[i].descricao %>
                                                            </div>
                                                            <% } %>
                                                                <div class="product-meta">
                                                                    <% if(produtos[i].validade && produtos[i].validade !== 'Produto sem validade') { %>
                                                                        <span class="meta-item">
                                                                            <i class="bi bi-calendar3"></i>
                                                                            <%= new Date(produtos[i].validade).toLocaleDateString('pt-BR') %>
                                                                        </span>
                                                                        <% } %>
                                                                            <span class="stock-badge <%= produtos[i].quantidade <= 0 ? 'stock-out' : produtos[i].quantidade <= 10 ? 'stock-low' : 'stock-in' %>">
                                                                                <%= produtos[i].quantidade <= 0 ? 'Esgotado' : produtos[i].quantidade <= 10 ? 'Últimas unid.' : 'Em estoque' %>
                                                                            </span>
                                                                </div>
                                                                <div class="price-row">
                                                                    <span class="price-now">R$ <%= produtos[i].preco %></span>
                                                                </div>
                                                                <button class="btn-add" <% if(produtos[i].quantidade <= 0) {
                                                                    %>disabled style="opacity:.5;cursor:not-allowed"<% }
                                                                        %>>
                                                                        <i class="bi bi-bag-plus me-1"></i>
                                                                        <%= produtos[i].quantidade > 0 ? 'Adicionar'
                                                                            : 'Indisponível' %>
                                                                </button>
                                            </div>
                            </div>
                        </div>
                        <% } %>
                </div>

                <div id="noFilterResults" class="empty-state" style="display:none">
                    <i class="bi bi-search"></i>
                    <h4>Nenhum resultado encontrado</h4>
                    <p>Tente buscar com outros termos ou limpar os filtros.</p>
                </div>
                <% } %>
    </div>
</section>

<!-- ════════════════════════════════
     TAB: PROMOÇÃO (Perto da validade)
════════════════════════════════ -->
<section class="products-section" id="tab-promocao" style="display:none">
    <div class="container">
        <!-- Promo Banner -->
        <div class="promo-alert mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="promo-alert-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h5 class="mb-1">Produtos em Promoção</h5>
                    <p class="mb-0">Estes produtos estão com validade próxima (até 90 dias) e por isso têm preços
                        especiais. Aproveite!</p>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="products-count">
                <% if(produtosPromocao && produtosPromocao.length> 0) { %>
                    <span>
                        <%= produtosPromocao.length %>
                    </span> produto(s) em promoção
                    <% } %>
            </div>
        </div>

        <% if(!produtosPromocao || produtosPromocao.length===0) { %>
            <div class="empty-state">
                <i class="bi bi-tags"></i>
                <h4>Nenhuma promoção no momento</h4>
                <p>Não há produtos com validade próxima em promoção. Volte em breve!</p>
                <button class="btn btn-hero mt-3" onclick="switchTab('todos')" style="border:none">
                    <i class="bi bi-grid me-1"></i> Ver Todos os Produtos
                </button>
            </div>
            <% } else { %>
                <div class="row g-3" id="promoGrid">
                    <% for(let i=0; i < produtosPromocao.length; i++) { %>
                        <div class="col-6 col-md-4 col-lg-3" data-promo-product
                            data-name="<%= produtosPromocao[i].nome.toLowerCase() %>"
                            data-category="<%= produtosPromocao[i].categoria %>"
                            data-price="<%= produtosPromocao[i].preco %>">
                            <div class="product-card h-100 promo-card">
                                <span class="badge-discount promo-badge-fire"><i
                                        class="bi bi-fire me-1"></i>-15%</span>

                                <button class="wishlist-btn" title="Adicionar à lista de desejos">
                                    <i class="bi bi-heart"></i>
                                </button>

                                <div class="img-wrap">
                                    <% if(produtosPromocao[i].img && produtosPromocao[i].img !== 'Imagem não disponível') { %>
                                        <img src="<%= produtosPromocao[i].img %>" alt="<%= produtosPromocao[i].nome %>"
                                            class="product-db-img" />
                                        <% } else { %>
                                            <i class="bi bi-capsule" style="font-size:3.5rem;color:rgba(0,0,0,.15)"></i>
                                            <% } %>
                                </div>

                                <div class="card-body">
                                    <% if(produtosPromocao[i].marca && produtosPromocao[i].marca !== 'Marca não disponível') { %>
                                        <div class="brand-tag">
                                            <%= produtosPromocao[i].marca %>
                                        </div>
                                        <% } %>
                                            <div class="prod-title">
                                                <%= produtosPromocao[i].nome %>
                                            </div>
                                            <% if(produtosPromocao[i].descricao && produtosPromocao[i].descricao !== 'Descrição não disponível') { %>
                                                <div class="product-desc">
                                                    <%= produtosPromocao[i].descricao %>
                                                </div>
                                                <% } %>
                                                    <div class="product-meta">
                                                        <% if(produtosPromocao[i].validade && produtosPromocao[i].validade !== 'Produto sem validade') { %>
                                                            <span class="meta-item validade-warn">
                                                                <i class="bi bi-calendar3"></i> Vence: <%= new Date(produtosPromocao[i].validade).toLocaleDateString('pt-BR') %>
                                                            </span>
                                                            <% } %>
                                                            <span class="stock-badge <%= produtosPromocao[i].quantidade <= 0 ? 'stock-out' : produtosPromocao[i].quantidade <= 10 ? 'stock-low' : 'stock-in' %>">
                                                                <%= produtosPromocao[i].quantidade <= 0 ? 'Esgotado' : produtosPromocao[i].quantidade <= 10 ? 'Últimas unid.' : 'Em estoque' %>
                                                            </span>
                                                    </div>
                                                    <div class="price-row">
                                                        <span class="price-now">R$ <%= produtosPromocao[i].preco %></span>
                                                    </div>
                                                    <button class="btn-add" <% if(produtosPromocao[i].quantidade <= 0) {
                                                        %>disabled style="opacity:.5;cursor:not-allowed"<% } %>>
                                                            <i class="bi bi-bag-plus me-1"></i>
                                                            <%= produtosPromocao[i].quantidade > 0 ? 'Adicionar'
                                                                : 'Indisponível' %>
                                                    </button>
                                </div>
                            </div>
                        </div>
                        <% } %>
                </div>
                <% } %>
    </div>
</section>

<script src="/js/produtos-user.js"></script>