                </div>
                <div class="hero-img-wrap">
                    <img src="https://placehold.co/300x420/4E8098/FFFFFF?text=Suplementos" alt="Suplementos" />
                </div>
                <div class="hero-product-badge">
                    <div class="prod-name">💊 Ômega 3 2g</div>
                    <div class="prod-price">R$ 49,90</div>
                </div>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-item">
            <div class="hero-slide hero-slide-3">
                <div class="hero-circle hero-circle-1"></div>
                <div class="hero-circle hero-circle-2"></div>
                <div class="hero-content">
                    <span class="hero-badge"><i class="bi bi-heart-pulse-fill me-1"></i> Cuidados com
                        Saúde</span>
                    <h1 class="hero-title">Sua<br />Saúde</h1>
                    <p class="hero-subtitle">Produtos dermocosméticos e de higiene com entrega rápida.</p>
                    <a href="/shop" class="btn btn-hero">Explorar</a>
