<!-- ════════════════════════════════
     HERO CAROUSEL  — produtos reais (imagem + preço)
════════════════════════════════ -->
<%
var heroPromos = (typeof promocoes !== 'undefined' && Array.isArray(promocoes)) ? promocoes : [];
var heroProds  = (typeof produtos  !== 'undefined' && Array.isArray(produtos))  ? produtos  : [];

function brl(v){ return 'R$ ' + Number(v || 0).toFixed(2).replace('.', ','); }

var heroSlides = [];
var heroVistos = new Set();

heroPromos.slice(0, 2).forEach(function(p){
    var orig  = Number(p.precoOriginal || 0);
    var promo = Number(p.precoPromocional || 0);
    heroSlides.push({
        badge:    'Oferta Especial',
        icon:     'bi-tag-fill',
        nome:     p.nomeProduto,
        marca:    p.marca || 'FarmaFipp',
        img:      p.imgProduto ? '/img/produtos/' + p.imgProduto : '/img/produtos/imagem.png',
        preco:    promo,
        precoOriginal: orig > promo ? orig : 0,
        desconto: Number(p.porcentagem || 0)
    });
    heroVistos.add(String(p.idProduto));
});

heroProds.forEach(function(pr){
    if (heroSlides.length >= 5) return;
    if (heroVistos.has(String(pr.id))) return;
    heroSlides.push({
        badge:    'Destaque',
        icon:     'bi-stars',
        nome:     pr.nome,
        marca:    pr.marca || 'FarmaFipp',
        img:      pr.img ? pr.img : '/img/produtos/imagem.png',
        preco:    Number(pr.preco || 0),
        precoOriginal: 0,
        desconto: 0
    });
    heroVistos.add(String(pr.id));
});

if (heroSlides.length === 0) {
    heroSlides = [
        { badge:'Farmácia Online', icon:'bi-stars', nome:'Bem-vindo à FarmaFipp', marca:'Sua farmácia online de confiança', img:'/img/produtos/imagem.png', preco:0, precoOriginal:0, desconto:0 }
    ];
}

var heroThemes = ['hero-slide-1', 'hero-slide-2', 'hero-slide-3'];
%>
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-indicators">
        <% heroSlides.forEach(function(s, i){ %>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= i %>"
            class="<%= i === 0 ? 'active' : '' %>" <%- i === 0 ? 'aria-current="true"' : '' %>
            aria-label="Ir para o destaque <%= i + 1 %>: <%= s.nome %>"></button>
        <% }); %>
    </div>

    <div class="carousel-inner">

        <% heroSlides.forEach(function(s, i){ %>
        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <div class="hero-slide <%= heroThemes[i % heroThemes.length] %>">
                <div class="hero-circle hero-circle-1"></div>
                <div class="hero-circle hero-circle-2"></div>

                <div class="hero-content">
                    <span class="hero-badge"><i class="bi <%= s.icon %> me-1"></i> <%= s.badge %></span>
                    <h1 class="hero-title"><%= s.nome %></h1>

                    <% if (s.preco > 0) { %>
                    <div class="hero-price-row">
                        <span class="hero-price"><%= brl(s.preco) %></span>
                        <% if (s.precoOriginal) { %>
                            <span class="hero-price-old"><%= brl(s.precoOriginal) %></span>
                        <% } %>
                        <% if (s.desconto > 0) { %>
                            <span class="hero-discount">-<%= s.desconto.toFixed(0) %>%</span>
                        <% } %>
                    </div>
                    <% } %>

                    <p class="hero-subtitle"><%= s.marca %> · Entrega rápida em todo o Brasil.</p>

                    <div class="hero-actions">
                        <a href="/shop" class="btn btn-hero">Comprar Agora</a>
                        <a href="/shop" class="btn btn-hero-outline">Ver Ofertas</a>
                    </div>
                </div>

                <div class="hero-showcase">
                    <div class="hero-img-wrap">
                        <img src="<%= s.img %>" alt="<%= s.nome %>" loading="lazy" />
                    </div>
                    <div class="hero-product-badge">
                        <div class="prod-name"><%= s.nome %></div>
                        <% if (s.preco > 0) { %>
                        <div class="prod-price"><%= brl(s.preco) %></div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>

    </div><!-- /.carousel-inner -->

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Próximo</span>
    </button>

</div><!-- /#heroCarousel -->


<!-- ════════════════════════════════
     BANNERS PROMOCIONAIS
════════════════════════════════ -->
<%
var bannerSource = (typeof promocoes !== 'undefined' && Array.isArray(promocoes)) ? promocoes : [];
var bannerThemes = ['banner-yellow', 'banner-teal'];
var bannerPromos = bannerSource.map(function(p){
    return {
        nome: p.nomeProduto,
        categoria: p.categoria || 'Oferta por tempo limitado',
        desconto: Number(p.porcentagem || 0)
    };
}).filter(function(b){ return b.desconto > 0; }).slice(0, 2);
%>
<section class="py-4">
    <div class="container">
        <div class="row g-3">
            <% bannerPromos.forEach(function(b, i){ %>
            <div class="col-md-4">
                <div class="promo-banner <%= bannerThemes[i % bannerThemes.length] %>">
                    <span class="badge-off">-<%= b.desconto %>%</span>
                    <h6><%= b.nome %></h6>
                    <p><%= b.categoria %></p>
                    <a href="/shop?filtro=promocao" class="btn btn-sm btn-dark mt-2 btn-rounded">Ver Produto</a>
                </div>
            </div>
            <% }); %>
            <div class="col-md-4">
                <div class="promo-banner banner-dark">
                    <h6><i class="bi bi-arrow-repeat me-1"></i>Trocas e Devoluções</h6>
                    <p>O produto veio com defeito ou você não gostou? Clique aqui para devolver ou trocar!</p>
                    <a href="/pos-venda/online" class="btn btn-sm btn-light mt-2 btn-rounded">Devolver ou Trocar</a>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ════════════════════════════════
     CATEGORIAS POPULARES
════════════════════════════════ -->
<section class="py-4 bg-white">
    <div class="container">
        <h2 class="section-title text-center mb-4">Categorias Populares</h2>
        <%
        var catList = (typeof categorias !== 'undefined' && Array.isArray(categorias)) ? categorias : [];
        var catColors = ['cat-bg-yellow','cat-bg-pink','cat-bg-blue','cat-bg-purple','cat-bg-green','cat-bg-orange'];
        function catEmoji(nome){
            var n = (nome || '').toLowerCase();
            if (n.indexOf('vitamin') > -1 || n.indexOf('suplement') > -1) return '💊';
            if (n.indexOf('dermo') > -1 || n.indexOf('cosm') > -1) return '🧴';
            if (n.indexOf('higiene') > -1) return '🧼';
            if (n.indexOf('infantil') > -1 || n.indexOf('bebê') > -1 || n.indexOf('bebe') > -1) return '🍼';
            if (n.indexOf('xampu') > -1 || n.indexOf('condicionador') > -1 || n.indexOf('tintura') > -1 || n.indexOf('colorante') > -1) return '🧴';
            if (n.indexOf('aparelho') > -1 || n.indexOf('teste') > -1) return '🩺';
            if (n.indexOf('primeiros socorros') > -1) return '🩹';
            if (n.indexOf('antibiót') > -1 || n.indexOf('antibiot') > -1 || n.indexOf('prescri') > -1 || n.indexOf('contínuo') > -1 || n.indexOf('continuo') > -1) return '💉';
            if (n.indexOf('analgés') > -1 || n.indexOf('antitérm') > -1 || n.indexOf('inflam') > -1 || n.indexOf('alérg') > -1 || n.indexOf('alerg') > -1) return '💊';
            return '🏥';
        }
        %>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 row-cols-lg-6 g-3 justify-content-center text-center">

            <% catList.forEach(function(nome, i){ %>
            <div class="col">
                <a href="/shop?categoria=<%= encodeURIComponent(nome) %>" class="category-pill">
                    <div class="cat-icon-wrap <%= catColors[i % catColors.length] %>"><%= catEmoji(nome) %></div>
                    <span class="cat-label"><%= nome %></span>
                </a>
            </div>
            <% }); %>

        </div>
    </div>
</section>
<!-- ════════════════════════════════
     MELHORES OFERTAS DO DIA
════════════════════════════════ -->
<%
var promosList = (typeof promocoes !== 'undefined' && Array.isArray(promocoes)) ? promocoes : [];
%>
<section class="py-5">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title mb-0">Melhores Ofertas do Dia</h2>
            <a href="/shop?filtro=promocao" class="see-all-link">Ver todas <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="row g-3">

        <% if (promosList.length > 0) { %>
            <% promosList.slice(0, 4).forEach(function(promo) {
                var imgSrc = promo.imgProduto
                    ? '/img/produtos/' + promo.imgProduto
                    : '/img/produtos/imagem.png';
                var precoOrig = Number(promo.precoOriginal || 0);
                var precoPromo = Number(promo.precoPromocional || 0);
                var desconto = Number(promo.porcentagem || 0);
            %>
                <div class="col-6 col-md-4 col-lg-3">
                    <article class="shop-product-card card-promo-highlight">
                        <% if (desconto > 0) { %>
                            <span class="card-badge card-badge-promo"><i class="bi bi-tag-fill me-1"></i>-<%= desconto %>%</span>
                        <% } %>
                        <button class="wishlist-btn" title="Favoritar"><i class="bi bi-heart"></i></button>
                        <a href="/produto/<%= promo.idProduto %>" class="card-link">
                            <div class="card-img-area">
                                <img src="<%= imgSrc %>" alt="<%= promo.nomeProduto %>" />
                            </div>
                            <div class="card-info">
                                <div class="card-brand"><%= promo.marca || 'FarmaFipp' %></div>
                                <div class="card-title"><%= promo.nomeProduto %></div>
                                <% if (promo.categoria) { %>
                                    <div class="card-category"><i class="bi bi-grid"></i> <%= promo.categoria %></div>
                                <% } %>
                                <div class="card-price-row">
                                    <% if (desconto > 0) { %>
                                        <div class="price-promo-wrap">
                                            <span class="price-original">R$ <%= precoOrig.toFixed(2).replace('.', ',') %></span>
                                            <span class="price-promo">R$ <%= precoPromo.toFixed(2).replace('.', ',') %></span>
                                        </div>
                                    <% } else { %>
                                        <span class="price-current">R$ <%= precoPromo.toFixed(2).replace('.', ',') %></span>
                                    <% } %>
                                </div>
                            </div>
                        </a>
                    </article>
                </div>
            <% }); %>
        <% } else { %>
            <% var fallbackList = (typeof produtos !== 'undefined' && Array.isArray(produtos)) ? produtos.slice(0, 4) : []; %>
            <% if (fallbackList.length > 0) { %>
                <% fallbackList.forEach(function(prod){
                    var fImg = prod.img ? prod.img : '/img/produtos/imagem.png';
                    var fPreco = Number(prod.preco || 0);
                %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <article class="shop-product-card">
                            <button class="wishlist-btn" title="Favoritar"><i class="bi bi-heart"></i></button>
                            <a href="/produto/<%= prod.id %>" class="card-link">
                                <div class="card-img-area">
                                    <img src="<%= fImg %>" alt="<%= prod.nome %>" />
                                </div>
                                <div class="card-info">
                                    <div class="card-brand"><%= prod.marca || 'FarmaFipp' %></div>
                                    <div class="card-title"><%= prod.nome %></div>
                                    <% if (prod.categoria) { %>
                                        <div class="card-category"><i class="bi bi-grid"></i> <%= prod.categoria %></div>
                                    <% } %>
                                    <div class="card-price-row">
                                        <span class="price-current">R$ <%= fPreco.toFixed(2).replace('.', ',') %></span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center text-muted py-4">Nenhuma oferta disponível no momento.</div>
            <% } %>
        <% } %>

        </div>
    </div>
</section>


<!-- ════════════════════════════════
     DESTAQUE DA SEMANA + MARCAS
════════════════════════════════ -->
<section class="py-2 pb-5">
    <div class="container">
        <div class="row g-4">

            <%
            var weeklySrc = (typeof promocoes !== 'undefined' && Array.isArray(promocoes)) ? promocoes.slice() : [];
            function weeklyDesconto(p){
                return Number(p.porcentagem || 0);
            }
            weeklySrc.sort(function(a, b){ return weeklyDesconto(b) - weeklyDesconto(a); });
            var weekly = null;
            if (weeklySrc.length > 0) {
                var wp = weeklySrc[0];
                weekly = {
                    nome: wp.nomeProduto,
                    img: wp.imgProduto ? '/img/produtos/' + wp.imgProduto : '/img/produtos/imagem.png',
                    preco: Number(wp.precoPromocional || 0),
                    desconto: weeklyDesconto(wp),
                    link: '/shop?filtro=promocao'
                };
            } else {
                var weeklyProds = (typeof produtos !== 'undefined' && Array.isArray(produtos)) ? produtos : [];
                if (weeklyProds.length > 0) {
                    var wd = weeklyProds[0];
                    weekly = {
                        nome: wd.nome,
                        img: wd.img ? wd.img : '/img/produtos/imagem.png',
                        preco: Number(wd.preco || 0),
                        desconto: 0,
                        link: '/shop'
                    };
                }
            }
            %>
            <% if (weekly) { %>
            <div class="col-lg-4">
                <div class="weekly-card h-100 d-flex flex-column">
                    <span class="label">Destaque da Semana</span>
                    <h5 class="mt-1"><%= weekly.nome %></h5>
                    <p class="text-muted small">
                        <% if (weekly.desconto > 0) { %>
                            Aproveite <%= weekly.desconto %>% de desconto por tempo limitado.
                        <% } else { %>
                            Um dos produtos preferidos dos nossos clientes.
                        <% } %>
                    </p>
                    <div class="text-center my-auto py-3">
                        <img class="weekly-img" src="<%= weekly.img %>" alt="<%= weekly.nome %>" />
                    </div>
                    <div class="fw-bold fs-5 text-danger">R$ <%= weekly.preco.toFixed(2).replace('.', ',') %></div>
                    <a href="<%= weekly.link %>" class="btn-weekly-cta btn-rounded mt-2">Ver Produto <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <% } %>

            <%
            var marcasList = (typeof marcas !== 'undefined' && Array.isArray(marcas)) ? marcas.slice(0, 10) : [];
            %>
            <% if (marcasList.length > 0) { %>
            <div class="col-lg-8">
                <div class="brands-section h-100">
                    <h2 class="section-title mb-4">Nossas Marcas Parceiras</h2>
                    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-3 align-items-center">
                        <% marcasList.forEach(function(marca){ %>
                        <div class="col">
                            <span class="brand-chip"><i class="bi bi-patch-check-fill"></i><%= marca %></span>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
            <% } %>

        </div>
    </div>
</section>


<!-- ════════════════════════════════
     PRODUTOS EM DESTAQUE
════════════════════════════════ -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title mb-0">Produtos em Destaque</h2>
            <a href="/shop" class="see-all-link">Ver todos <i class="bi bi-arrow-right"></i></a>
        </div>
        <%
        var destaqueList = (typeof produtos !== 'undefined' && Array.isArray(produtos)) ? produtos : [];
        %>
        <div class="row g-3">

            <% if (destaqueList.length > 0) { %>
                <% destaqueList.forEach(function(prod){
                    var pImg = prod.img ? prod.img : '/img/produtos/imagem.png';
                    var pPreco = Number(prod.preco || 0);
                    var pEstoque = Number(prod.quantidade || 0);
                %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <article class="shop-product-card">
                            <% if (pEstoque <= 0) { %>
                                <span class="card-badge card-badge-esgotado">Esgotado</span>
                            <% } else if (pEstoque <= 10) { %>
                                <span class="card-badge card-badge-ultimas">Últimas unid.</span>
                            <% } %>
                            <button class="wishlist-btn" title="Favoritar"><i class="bi bi-heart"></i></button>
                            <a href="/produto/<%= prod.id %>" class="card-link">
                                <div class="card-img-area">
                                    <img src="<%= pImg %>" alt="<%= prod.nome %>" />
                                </div>
                                <div class="card-info">
                                    <div class="card-brand"><%= prod.marca || 'FarmaFipp' %></div>
                                    <div class="card-title"><%= prod.nome %></div>
                                    <% if (prod.categoria) { %>
                                        <div class="card-category"><i class="bi bi-grid"></i> <%= prod.categoria %></div>
                                    <% } %>
                                    <div class="card-price-row">
                                        <span class="price-current">R$ <%= pPreco.toFixed(2).replace('.', ',') %></span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center text-muted py-4">Nenhum produto disponível no momento.</div>
            <% } %>

        </div>
    </div>
</section>


<!-- ════════════════════════════════
     BANNER CONFIANÇA
════════════════════════════════ -->
<section class="py-4 trust-section">
    <div class="container">
        <div class="row text-white text-center g-4">
            <div class="col-6 col-md-3">
                <i class="bi bi-truck fs-2"></i>
                <div class="trust-item-title mt-1">Entrega Rápida
                </div>
                <div class="small opacity-75">Em todo o Brasil</div>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-shield-check fs-2"></i>
                <div class="trust-item-title mt-1">100% Seguro</div>
                <div class="small opacity-75">Pagamento protegido</div>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-award fs-2"></i>
                <div class="trust-item-title mt-1">Produtos
                    Originais</div>
                <div class="small opacity-75">Garantia de autenticidade</div>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-headset fs-2"></i>
                <div class="trust-item-title mt-1">Suporte 24h</div>
                <div class="small opacity-75">Atendimento farmacêutico</div>
            </div>
        </div>
    </div>
</section>
<script>
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const icon = this.querySelector('i');
            icon.classList.toggle('bi-heart');
            icon.classList.toggle('bi-heart-fill');
            this.style.color = icon.classList.contains('bi-heart-fill') ? 'var(--primary-red)' : '';
        });
    });
</script>