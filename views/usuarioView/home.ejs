<!-- ════════════════════════════════
     HERO CAROUSEL  — produtos reais (imagem + preço)
════════════════════════════════ -->
<%
// Monta os slides do hero a partir de dados reais: promoções → produtos → fallback.
var heroPromos = (typeof promocoes !== 'undefined' && Array.isArray(promocoes)) ? promocoes : [];
var heroProds  = (typeof produtos  !== 'undefined' && Array.isArray(produtos))  ? produtos  : [];

function brl(v){ return 'R$ ' + Number(v || 0).toFixed(2).replace('.', ','); }

var heroSlides = [];

// 1) Melhores ofertas em destaque
heroPromos.slice(0, 4).forEach(function(p){
    var orig  = Number(p.precoOriginal || 0);
    var promo = Number(p.precoPromocional || 0);
    heroSlides.push({
        badge:    'Oferta Especial',
        icon:     'bi-tag-fill',
        nome:     p.nomeProduto,
        marca:    p.marca || 'FarmaFipp',
        img:      p.imgProduto ? '/img/produtos/' + p.imgProduto : 'https://placehold.co/440x440/ffffff/4E8098?text=Produto',
        preco:    promo,
        precoOriginal: orig > promo ? orig : 0,
        desconto: Number(p.porcentagem || 0)
    });
});

// 2) Completa com produtos em destaque até ao menos 3 slides
heroProds.forEach(function(pr){
    if (heroSlides.length >= 3) return;
    heroSlides.push({
        badge:    'Destaque',
        icon:     'bi-stars',
        nome:     pr.nome,
        marca:    pr.marca || 'FarmaFipp',
        img:      pr.img ? pr.img : 'https://placehold.co/440x440/ffffff/4E8098?text=Produto',
        preco:    Number(pr.preco || 0),
        precoOriginal: 0,
        desconto: 0
    });
});

// 3) Fallback total — mantém o hero funcional mesmo sem dados
if (heroSlides.length === 0) {
    heroSlides = [
        { badge:'Farmácia Online #1', icon:'bi-stars',          nome:'Vitamina C 1000mg', marca:'FarmaFipp', img:'https://placehold.co/440x440/ffffff/2D6A4F?text=Vitamina+C', preco:29.90, precoOriginal:0,     desconto:0  },
        { badge:'Oferta Especial',    icon:'bi-tag-fill',       nome:'Ômega 3 2g',        marca:'FarmaFipp', img:'https://placehold.co/440x440/ffffff/4E8098?text=Omega+3',    preco:49.90, precoOriginal:69.90, desconto:28 },
        { badge:'Cuidados com Saúde', icon:'bi-heart-pulse-fill', nome:'Protetor FPS 60', marca:'FarmaFipp', img:'https://placehold.co/440x440/ffffff/A31621?text=Protetor',  preco:34.90, precoOriginal:0,     desconto:0  }
    ];
}

var heroThemes = ['hero-slide-1', 'hero-slide-2', 'hero-slide-3'];
%>
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-indicators">
        <% heroSlides.forEach(function(s, i){ %>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= i %>"
            class="<%= i === 0 ? 'active' : '' %>" <%- i === 0 ? 'aria-current="true"' : '' %>
            aria-label="Ir para o destaque <%= i + 1 %>: <%= s.nome %>"></button>
        <% }); %>
    </div>

    <div class="carousel-inner">

        <% heroSlides.forEach(function(s, i){ %>
        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <div class="hero-slide <%= heroThemes[i % heroThemes.length] %>">
                <div class="hero-circle hero-circle-1"></div>
                <div class="hero-circle hero-circle-2"></div>

                <div class="hero-content">
                    <span class="hero-badge"><i class="bi <%= s.icon %> me-1"></i> <%= s.badge %></span>
                    <h1 class="hero-title"><%= s.nome %></h1>

                    <div class="hero-price-row">
                        <span class="hero-price"><%= brl(s.preco) %></span>
                        <% if (s.precoOriginal) { %>
                            <span class="hero-price-old"><%= brl(s.precoOriginal) %></span>
                        <% } %>
                        <% if (s.desconto > 0) { %>
                            <span class="hero-discount">-<%= s.desconto.toFixed(0) %>%</span>
                        <% } %>
                    </div>

                    <p class="hero-subtitle"><%= s.marca %> · Entrega rápida em todo o Brasil.</p>

                    <div class="hero-actions">
                        <a href="/shop" class="btn btn-hero">Comprar Agora</a>
                        <a href="/shop" class="btn btn-hero-outline">Ver Ofertas</a>
                    </div>
                </div>

                <div class="hero-showcase">
                    <div class="hero-img-wrap">
                        <img src="<%= s.img %>" alt="<%= s.nome %>" loading="lazy" />
                    </div>
                    <div class="hero-product-badge">
                        <div class="prod-name"><%= s.nome %></div>
                        <div class="prod-price"><%= brl(s.preco) %></div>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>

    </div><!-- /.carousel-inner -->

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Próximo</span>
    </button>

</div><!-- /#heroCarousel -->


