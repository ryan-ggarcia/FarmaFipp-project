            aria-label="Ir para o destaque 2: Suplementos"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"
            aria-label="Ir para o destaque 3: Sua Saúde"></button>
    </div>

    <div class="carousel-inner">

