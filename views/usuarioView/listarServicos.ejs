<%
const servicos = Array.isArray(listaServicos) ? listaServicos : [];

function formatarDataHora(value) {
	if (!value) return "-";
	const data = new Date(value);
	if (Number.isNaN(data.getTime())) return "-";

	return new Intl.DateTimeFormat("pt-BR", {
		day: "2-digit",
		month: "2-digit",
		year: "numeric",
		hour: "2-digit",
		minute: "2-digit"
	}).format(data);
}

function mapearStatus(status) {
	const statusNum = Number(status);
	if (statusNum === 1) return { texto: "Agendado", classe: "bg-primary" };
	if (statusNum === 2) return { texto: "Concluido", classe: "bg-success" };
	if (statusNum === 3) return { texto: "Cancelado", classe: "bg-danger" };
	return { texto: "Indefinido", classe: "bg-secondary" };
}
%>

<div class="container py-4 py-md-5">
	<div class="row justify-content-center">
		<div class="col-12 col-xl-10">
			<div class="d-flex justify-content-between align-items-center mb-4">
				<h1 class="h3 m-0">Meus Servicos Agendados</h1>
				<a href="/servicos" class="btn btn-outline-primary">Novo agendamento</a>
			</div>

			<% if (servicos.length === 0) { %>
				<div class="card border-0 shadow-sm">
					<div class="card-body p-4 p-md-5 text-center">
						<h2 class="h5 mb-2">Voce ainda nao possui servicos ativos</h2>
						<p class="text-muted mb-4">Assim que voce realizar um agendamento ativo, ele sera exibido aqui.</p>
						<a href="/servicos" class="btn btn-primary">Agendar servico</a>
					</div>
				</div>
			<% } else { %>
				<div class="card border-0 shadow-sm d-none d-md-block">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th scope="col">Data e Hora</th>
									<th scope="col">Servico</th>
									<th scope="col">Observacao</th>
									<th scope="col" class="text-center">Status</th>
                                    <th scope="col" class="text-center">Acoes</th>
								</tr>
							</thead>
							<tbody>
								<% servicos.forEach(servico => {
									const status = mapearStatus(servico.serv_status);
								%>
									<tr>
										<td><%= formatarDataHora(servico.serv_data) %></td>
										<td><%= servico.tipo_nome || "-" %></td>
										<td><%= servico.serv_obs || "Sem observacao" %></td>
										<td class="text-center">
											<span class="badge <%= status.classe %>"><%= status.texto %></span>
										</td>
                                        <td class="text-center">
                                            <a href="/servicos/editar/<%= servico.serv_id %>" class="btn btn-sm btn-outline-primary">Editar</a>
                                            <button data-id="<%= servico.serv_id %>" class="btn btn-sm btn-outline-danger btnExcluir">Cancelar</button>
                                        </td>
									</tr>
								<% }) %>
							</tbody>
						</table>
					</div>
				</div>

				<div class="d-md-none">
					<% servicos.forEach(servico => {
						const status = mapearStatus(servico.serv_status);
					%>
						<div class="card border-0 shadow-sm mb-3">
							<div class="card-body">
								<div class="d-flex justify-content-between align-items-start mb-2">
									<h2 class="h6 mb-0"><%= servico.tipo_nome || "Servico" %></h2>
									<span class="badge <%= status.classe %>"><%= status.texto %></span>
								</div>
								<p class="mb-1"><strong>Data e hora:</strong> <%= formatarDataHora(servico.serv_data) %></p>
								<p class="mb-0"><strong>Observacao:</strong> <%= servico.serv_obs || "Sem observacao" %></p>
								<div class="d-flex justify-content-end mt-2">
									<a href="/servicos/editar/<%= servico.serv_id %>" class="btn btn-sm btn-outline-primary me-2">Editar</a>
									<button data-id="<%= servico.serv_id %>" class="btn btn-sm btn-outline-danger btnExcluir">Cancelar</button>
								</div>
							</div>
						</div>
					<% }) %>
				</div>
			<% } %>
		</div>
	</div>
</div>

<script src="/js/clientes/listarServicos.js"></script>
