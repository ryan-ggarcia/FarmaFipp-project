<link rel="stylesheet" href="/css/style-carrinho-user.css" />

<main class="checkout-page py-4 py-lg-5">
	<div class="container-xl">
		<div class="checkout-head d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
			<div>
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb mb-2">
						<li class="breadcrumb-item"><a href="/usuario">Início</a></li>
						<li class="breadcrumb-item"><a href="/usuario/shop">Produtos</a></li>
						<li class="breadcrumb-item active" aria-current="page">Finalizar pedido</li>
					</ol>
				</nav>
				<h1 class="checkout-title mb-0">Resumo do Pedido</h1>
			</div>
			<a href="/usuario/shop" class="btn btn-outline-secondary btn-back-shop">
				<i class="bi bi-arrow-left me-1"></i> Continuar comprando
			</a>
		</div>

		<div id="checkoutEmptyState" class="checkout-empty d-none">
			<div class="empty-icon"><i class="bi bi-bag-x"></i></div>
			<h2>Seu carrinho está vazio</h2>
			<p>Adicione produtos para visualizar o pedido e seguir para o pagamento.</p>
			<a href="/usuario/shop" class="btn btn-danger px-4">
				<i class="bi bi-grid me-1"></i> Ver produtos
			</a>
		</div>

		<div id="checkoutContent" class="row g-4">
			<section class="col-12 col-lg-8">
				<div class="checkout-card">
					<div class="checkout-card-header d-flex align-items-center justify-content-between">
						<h3 class="mb-0">Itens no carrinho</h3>
						<span class="small text-muted" id="checkoutItemsLabel">0 itens</span>
					</div>

					<div class="checkout-items-list" id="checkoutItemsList"></div>

					<div class="checkout-card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center">
						<small class="text-muted">Você pode ajustar quantidades antes de finalizar.</small>
						<button type="button" class="btn btn-outline-secondary btn-sm" id="btnCheckoutClear">
							<i class="bi bi-trash me-1"></i> Limpar carrinho
						</button>
					</div>
				</div>
			</section>

			<aside class="col-12 col-lg-4">
				<div class="checkout-card summary-card">
					<div class="checkout-card-header">
						<h3 class="mb-0">Resumo</h3>
					</div>

					<div class="summary-lines">
						<div class="summary-line">
							<span>Subtotal</span>
							<strong id="checkoutSubtotal">R$ 0,00</strong>
						</div>
						<div class="summary-line">
							<span>Entrega</span>
							<strong id="checkoutShipping">R$ 0,00</strong>
						</div>
						<div class="summary-line discount-line">
							<span>Desconto</span>
							<strong id="checkoutDiscount">- R$ 0,00</strong>
						</div>
					</div>

					<div class="total-line mt-2">
						<span>Total</span>
						<strong id="checkoutTotal">R$ 0,00</strong>
					</div>

					<div class="payment-section mt-4">
						<h4 class="payment-title">Forma de pagamento</h4>
						<div class="payment-grid" id="paymentMethods">
							<button type="button" class="payment-option active" data-payment="pix">
								<i class="bi bi-qr-code"></i>
								<span>PIX</span>
							</button>
							<button type="button" class="payment-option" data-payment="card">
								<i class="bi bi-credit-card"></i>
								<span>Cartão</span>
							</button>
							<button type="button" class="payment-option" data-payment="boleto">
								<i class="bi bi-receipt"></i>
								<span>Boleto</span>
							</button>
						</div>
					</div>

					<div class="d-grid gap-2 mt-4">
						<button type="button" class="btn btn-danger btn-lg" id="btnConfirmOrder">
							<i class="bi bi-check2-circle me-1"></i> Finalizar pagamento
						</button>
						<button type="button" class="btn btn-light btn-lg border" id="btnSimulateBack">
							Voltar para revisão
						</button>
					</div>

					<p class="secure-note mt-3 mb-0">
						<i class="bi bi-shield-check me-1"></i>
						Fluxo de pagamento apenas demonstrativo (front-end).
					</p>
				</div>
			</aside>
		</div>
	</div>
</main>

<script src="/js/produtos/checkout.js"></script>
