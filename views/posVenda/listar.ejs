<script src="/js/posVenda/listar.js"></script>
<div class="p-3 p-1-25">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3 class="mb-0">Pós-Venda</h3>
      <small class="text-muted">Gerencie devoluções e trocas de produtos</small>
    </div>
    <div>
      <a class="btn btn-primary custom btn-rounded" href="/admin/pos-venda/presencial">
        <i class="fas fa-plus me-2"></i>Registrar Devolução/Troca
      </a>
    </div>
  </div>

  <div class="card card-saas">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Tipo</th>
              <th>Origem</th>
              <th>Cliente</th>
              <th>Data da Compra</th>
              <th>Data da Solicitação</th>
              <th>Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if(lista.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">Nenhuma solicitação encontrada.</td>
              </tr>
            <% } %>
            <% for(let i = 0; i < lista.length; i++) { %>
              <tr>
                <td><%= lista[i].getID() %></td>
                <td>
                  <% if(lista[i].getTIPO() === 'Compra') { %>
                    <span class="badge bg-info">Devolução</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Troca</span>
                  <% } %>
                </td>
                <td>
                  <% if(lista[i].getORIGEM() === 'presencial') { %>
                    <i class="bi bi-shop me-1"></i>Presencial
                  <% } else { %>
                    <i class="bi bi-globe me-1"></i>Online
                  <% } %>
                </td>
                <td><%= lista[i].getNOMECLIENTE() || 'N/A' %></td>
                <td><%= lista[i].getDATACOMPRA() ? (lista[i].getDATACOMPRA() instanceof Date ? lista[i].getDATACOMPRA().toISOString().split('T')[0] : String(lista[i].getDATACOMPRA()).split('T')[0]) : 'N/A' %></td>
                <td><%= lista[i].getDATA() ? (lista[i].getDATA() instanceof Date ? lista[i].getDATA().toISOString().split('T')[0] : String(lista[i].getDATA()).split('T')[0]) : 'N/A' %></td>
                <td>
                  <% if(lista[i].getSTATUS() === 'Aguardando') { %>
                    <span class="badge bg-warning text-dark">Aguardando</span>
                  <% } else if(lista[i].getSTATUS() === 'Aprovado') { %>
                    <span class="badge bg-success">Aprovado</span>
                  <% } else if(lista[i].getSTATUS() === 'Nao Aprovado') { %>
                    <span class="badge bg-danger">Não Aprovado</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/admin/pos-venda/detalhes/<%= lista[i].getID() %>" class="btn btn-sm btn-primary btn-rounded me-2" title="Detalhes">
                    <i class="fas fa-eye"></i>
                  </a>
                  <button data-id="<%= lista[i].getID() %>" class="btn btn-sm btn-danger btn-rounded btnExcluir" title="Excluir">
                    <i class="fas fa-trash"></i>
                  </button>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
